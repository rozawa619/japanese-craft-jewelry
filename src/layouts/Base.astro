---
import '../styles/global.css';
import {site,pagePath,path,isPublic} from '../config/site';
interface Props {title:string;description?:string;article?:boolean;updatedAt?:string;noindex?:boolean}
const {title,description=site.description,article=false,updatedAt,noindex=false}=Astro.props;
const canonical=isPublic&&!noindex?new URL(Astro.url.pathname,site.url).href:undefined;
const nav=[['Objects','objects/'],['Kanagawa','places/kanagawa/'],['Journal','journal/'],['Our approach','editorial-policy/']];
const ld=canonical?{'@context':'https://schema.org','@type':article?'Article':'WebPage',headline:title,description,url:canonical,inLanguage:site.locale,...(updatedAt?{dateModified:updatedAt}:{})}:null;
---
<!doctype html><html lang={site.locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#293e32"/><title>{title} — {site.name}</title><meta name="description" content={description}/><meta name="robots" content={isPublic&&!noindex?'index, follow':'noindex, nofollow'}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={`${title} — ${site.name}`}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:locale" content="en_US"/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/>{ld&&<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g,'\\u003c')}/>}</head>
<body><a class="skip-link" href="#main">Skip to content</a><div class="masthead-note">A considered guide to Japanese craft <span>Beginning in Kanagawa, Japan</span></div>
<header class="site-header wrap"><a href={pagePath()} class="brand" aria-label="ITO home">ito<span class="brand-dot">.</span><span class="brand-tag">OBJECTS WITH A STORY</span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,route])=><a href={pagePath(route)} aria-current={Astro.url.pathname.includes('/'+route)?'page':undefined}>{label}</a>)}</nav><details class="mobile-nav"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{nav.map(([label,route])=><a href={pagePath(route)}>{label}</a>)}</nav></details><a class="header-cta" href={pagePath('objects/')}>Find an object <span aria-hidden="true">↗</span></a></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="wrap footer-grid"><div><a class="brand footer-brand" href={pagePath()}>ito<span class="brand-dot">.</span></a><p>Small objects.<br/>A closer connection.</p><p class="footer-description">An independent editorial guide to Japanese craft accessories. We introduce. Retailers sell and ship.</p></div><div><h2>Explore</h2><a href={pagePath('objects/')}>All objects</a><a href={pagePath('places/kanagawa/')}>Kanagawa</a><a href={pagePath('crafts/hakone-yosegi/')}>Yosegi woodcraft</a><a href={pagePath('journal/')}>The journal</a></div><div><h2>Good to know</h2><a href={pagePath('about/')}>About ITO</a><a href={pagePath('editorial-policy/')}>Editorial policy</a><a href={pagePath('affiliate-disclosure/')}>Affiliate disclosure</a><a href={pagePath('privacy/')}>Privacy</a><a href={pagePath('contact/')}>Contact & corrections</a></div></div><div class="wrap footer-bottom"><span>© 2026 {site.name}. Independently edited.</span><span>Made for a more considered choice.</span></div></footer></body></html>