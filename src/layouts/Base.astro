---
import '../styles/global.css';
import {site,siteDescription,pagePath,path,isPublic,localizedPath} from '../config/site';
import {t,type Locale} from '../lib/i18n';
import LanguageSwitch from '../components/LanguageSwitch.astro';
interface Props {title:string;description?:string;article?:boolean;updatedAt?:string;noindex?:boolean;locale?:Locale}
const {title,article=false,updatedAt,noindex=false,locale='en'}=Astro.props;
const description=Astro.props.description||siteDescription(locale);
const canonical=isPublic&&!noindex?new URL(Astro.url.pathname,site.url).href:undefined;
const nav=[[t(locale,'Jewelry','ジュエリー'),'objects/'],[t(locale,'Regions','産地をめぐる'),'places/'],[t(locale,'Journal','読みもの'),'journal/'],[t(locale,'Our approach','編集方針'),'editorial-policy/']];
const ld=canonical?{'@context':'https://schema.org','@type':article?'Article':'WebPage',headline:title,description,url:canonical,inLanguage:locale,...(updatedAt?{dateModified:updatedAt}:{})}:null;
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#293e32"/><title>{title} — {site.name}</title><meta name="description" content={description}/><meta name="robots" content={isPublic&&!noindex?'index, follow':'noindex, nofollow'}/>{canonical&&<><link rel="canonical" href={canonical}/>{(['en','ja'] as const).map(lang=><link rel="alternate" hreflang={lang} href={new URL(localizedPath(Astro.url.pathname,lang),site.url).href}/>)}</>}<meta property="og:title" content={`${title} — ${site.name}`}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:locale" content={locale==='ja'?'ja_JP':'en_US'}/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/>{ld&&<script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g,'\\u003c')}/>}</head>
<body><a class="skip-link" href="#main">{t(locale,'Skip to content','本文へ移動')}</a><div class="masthead-note">{t(locale,'A considered guide to Japanese craft jewelry','日本各地の工芸ジュエリーを、ていねいに選ぶ')}<span>{t(locale,'Makers, materials & stories from Japan','作り手・素材・ものがたり')}</span></div>
<header class="site-header wrap"><a href={pagePath('',locale)} class="brand" aria-label={t(locale,'ITO home','ITO トップ')}>ito<span class="brand-dot">.</span><span class="brand-tag">{t(locale,'CRAFT JEWELRY FROM JAPAN','日本の工芸ジュエリー')}</span></a><nav class="desktop-nav" aria-label={t(locale,'Main navigation','メインナビゲーション')}>{nav.map(([label,route])=><a href={pagePath(route,locale)} aria-current={Astro.url.pathname.includes('/'+route)?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><details class="mobile-nav"><summary>{t(locale,'Menu','メニュー')} <span aria-hidden="true">☰</span></summary><nav aria-label={t(locale,'Mobile navigation','モバイルナビゲーション')}>{nav.map(([label,route])=><a href={pagePath(route,locale)}>{label}</a>)}</nav></details><LanguageSwitch locale={locale}/></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="wrap footer-grid"><div><a class="brand footer-brand" href={pagePath('',locale)}>ito<span class="brand-dot">.</span></a><p>{t(locale,'A little jewelry.','小さなジュエリーから、')}<br/>{t(locale,'A closer connection.','ものづくりとつながる。')}</p><p class="footer-description">{t(locale,'An independent editorial guide to Japanese craft jewelry. We introduce the pieces and their stories. Retailers sell and ship.','日本各地の工芸ジュエリーを紹介する独立した編集メディアです。販売・決済・発送は外部の販売店が行います。')}</p></div><div><h2>{t(locale,'Explore','探す')}</h2><a href={pagePath('objects/',locale)}>{t(locale,'All jewelry','ジュエリー一覧')}</a><a href={pagePath('places/',locale)}>{t(locale,'Explore the regions','産地をめぐる')}</a><a href={pagePath('crafts/hakone-yosegi/',locale)}>{t(locale,'Yosegi woodcraft','箱根寄木細工')}</a><a href={pagePath('journal/',locale)}>{t(locale,'The journal','読みもの')}</a></div><div><h2>{t(locale,'Good to know','サイトについて')}</h2>{[['about/',t(locale,'About ITO','ITOについて')],['editorial-policy/',t(locale,'Editorial policy','編集方針')],['affiliate-disclosure/',t(locale,'Affiliate disclosure','広告・提携について')],['privacy/',t(locale,'Privacy','プライバシー')],['contact/',t(locale,'Contact & corrections','お問い合わせ・訂正')]].map(([route,label])=><a href={pagePath(route,locale)}>{label}</a>)}</div></div><div class="wrap footer-bottom"><span>© 2026 {site.name}. {t(locale,'Independently edited.','独立した編集方針で運営しています。')}</span><span>{t(locale,'Made for a more considered choice.','納得して選ぶための、小さな手がかりを。')}</span></div></footer><script>document.querySelectorAll<HTMLTableElement>('.prose table').forEach(table=>{table.tabIndex=0;table.setAttribute('aria-label',document.documentElement.lang==='ja'?'比較表。左右にスクロールできます。':'Comparison table. Scroll horizontally to read all columns.');});</script></body></html>
