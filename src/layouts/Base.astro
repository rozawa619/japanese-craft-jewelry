---
import '../styles/global.css';
import {site,siteDescription,pagePath,path,isPublic,localizedPath} from '../config/site';
import {t,type Locale} from '../lib/i18n';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import {serializeJsonLd} from '../lib/structured-data';
import {productsFor} from '../lib/catalog';
interface Props {title:string;description?:string;article?:boolean;updatedAt?:string;noindex?:boolean;locale?:Locale}
const {title,article=false,updatedAt,noindex=false,locale='en'}=Astro.props;
const description=Astro.props.description||siteDescription(locale);
const pageTitle=title.includes(site.name)?title:`${title} | ${site.name}`;
const canonical=isPublic&&!noindex?new URL(Astro.url.pathname,site.url).href:undefined;
const nav=[[t(locale,'The selection','商品セレクト'),'objects/'],[t(locale,'By region','産地から選ぶ'),'places/'],[t(locale,'How we select','セレクトの方針'),'editorial-policy/']];
const materialLinks=[['wood',t(locale,'Wood jewelry','木のジュエリー')],['glass',t(locale,'Glass jewelry','ガラスのジュエリー')],['porcelain',t(locale,'Porcelain jewelry','陶磁器のジュエリー')]].filter(([id])=>productsFor(locale).some(product=>product.materialIds.includes(id)));
const ld=canonical?{'@context':'https://schema.org','@type':article?'Article':'WebPage',headline:title,description,url:canonical,inLanguage:locale,...(updatedAt?{dateModified:updatedAt}:{})}:null;
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#293e32"/><meta name="referrer" content="strict-origin-when-cross-origin"/><title>{pageTitle}</title><meta name="description" content={description}/><meta name="robots" content={isPublic&&!noindex?'index, follow':'noindex, nofollow'}/>{canonical&&<><link rel="canonical" href={canonical}/>{(['en','ja'] as const).map(lang=><link rel="alternate" hreflang={lang} href={new URL(localizedPath(Astro.url.pathname,lang),site.url).href}/>)}</>}<meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:site_name" content={site.name}/><meta property="og:type" content={article?'article':'website'}/>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:locale" content={locale==='ja'?'ja_JP':'en_US'}/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/>{ld&&<script type="application/ld+json" set:html={serializeJsonLd(ld)}/>}</head>
<body><a class="skip-link" href="#main">{t(locale,'Skip to content','本文へ移動')}</a><div class="masthead-note">{t(locale,'A curated selection of Japanese craft jewelry','日本各地の工芸ジュエリーを、ていねいに選ぶ')}<span>{t(locale,'Selected pieces. Japanese craft.','作り手・素材・ものがたり')}</span></div>
<header class="site-header wrap"><a href={pagePath('',locale)} class="brand" aria-label={t(locale,'Japanese Craft Jewelry home','Japanese Craft Jewelry トップ')}><span class="brand-name"><span>Japanese </span><span>Craft Jewelry<span class="brand-dot">.</span></span></span><span class="brand-tag">{t(locale,'CURATED JAPANESE JEWELRY','日本の工芸ジュエリー')}</span></a><nav class="desktop-nav" aria-label={t(locale,'Main navigation','メインナビゲーション')}>{nav.map(([label,route])=><a href={pagePath(route,locale)} aria-current={Astro.url.pathname.includes('/'+route)?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><details class="mobile-nav"><summary>{t(locale,'Menu','メニュー')} <span aria-hidden="true">☰</span></summary><nav aria-label={t(locale,'Mobile navigation','モバイルナビゲーション')}>{nav.map(([label,route])=><a href={pagePath(route,locale)}>{label}</a>)}</nav></details><LanguageSwitch locale={locale}/></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="wrap footer-grid"><div><a class="brand footer-brand" href={pagePath('',locale)}><span class="brand-name"><span>Japanese </span><span>Craft Jewelry<span class="brand-dot">.</span></span></span></a><p>{t(locale,'A little jewelry.','小さなジュエリーから、')}<br/>{t(locale,'A closer connection.','ものづくりとつながる。')}</p><p class="footer-description">{t(locale,'Discover Japanese craft jewelry through its design, materials and the people who make it.','デザイン、素材、ものづくりの背景から、日本各地の工芸ジュエリーを紹介します。')}</p></div><div><h2>{t(locale,'Explore','探す')}</h2><a href={pagePath('objects/',locale)}>{t(locale,'All jewelry','ジュエリー一覧')}</a><a href={pagePath('places/',locale)}>{t(locale,'Jewelry by region','産地別の商品')}</a>{materialLinks.map(([id,label])=><a href={pagePath('objects/?material='+id,locale)}>{label}</a>)}</div><div><h2>{t(locale,'Good to know','サイトについて')}</h2>{[['about/',t(locale,'About Japanese Craft Jewelry','Japanese Craft Jewelryについて')],['editorial-policy/',t(locale,'Selection policy','選定方針')],['affiliate-disclosure/',t(locale,'Affiliate disclosure','広告・提携について')],['privacy/',t(locale,'Privacy','プライバシー')]].map(([route,label])=><a href={pagePath(route,locale)}>{label}</a>)}</div></div><div class="wrap footer-bottom"><span>© 2026 {site.name}. {t(locale,'Independently selected.','独立した方針で商品を選定しています。')}</span><span>{t(locale,'Made for a more considered choice.','納得して選ぶための、小さな手がかりを。')}</span></div></footer><script>document.querySelectorAll<HTMLTableElement>('.prose table').forEach(table=>{table.tabIndex=0;table.setAttribute('aria-label',document.documentElement.lang==='ja'?'比較表。左右にスクロールできます。':'Comparison table. Scroll horizontally to read all columns.');});</script></body></html>
