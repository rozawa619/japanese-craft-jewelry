---
import {getCollection,render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Disclosure from '../../../components/Disclosure.astro';
import Comparison from '../../../components/Comparison.astro';
import ProductCard from '../../../components/ProductCard.astro';
import {products} from '../../../lib/catalog';
import {pagePath} from '../../../config/site';
export async function getStaticPaths(){return(await getCollection('guides',({data})=>data.publishStatus==='published')).map(guide=>({params:{slug:guide.id},props:{guide}}))}
const {guide}=Astro.props;
const {Content}=await render(guide);
const compare=guide.id==='everyday-craft-earrings';
const related=guide.data.productIds.length?products.filter(p=>guide.data.productIds.includes(p.id)):products.slice(0,3);
---
<Base title={guide.data.title} description={guide.data.description} article updatedAt={guide.data.updatedAt}><div class="article-wrap"><header class="page-heading"><div class="breadcrumbs"><a href={pagePath('journal/')}>Journal</a><span>/</span><span>{guide.data.category}</span></div><h1>{guide.data.title}</h1><p>{guide.data.description}</p></header><div class="article-meta"><span>ITO editorial desk · Primary-source research</span><span>Updated {guide.data.updatedAt}</span><span>{guide.data.readMinutes} min read</span></div><Disclosure productIds={related.map(p=>p.id)}/><article class="prose"><Content/></article></div><div class="wrap">{compare&&<Comparison/>}<section class="related"><h2>Objects to investigate.</h2><div class="product-grid">{related.slice(0,3).map((p,i)=><ProductCard product={p} index={i}/>)}</div></section></div></Base>