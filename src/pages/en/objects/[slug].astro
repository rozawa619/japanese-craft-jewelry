---
import {getCollection,render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Pattern from '../../../components/Pattern.astro';
import Disclosure from '../../../components/Disclosure.astro';
import RetailerLink from '../../../components/RetailerLink.astro';
import Sources from '../../../components/Sources.astro';
import ProductCard from '../../../components/ProductCard.astro';
import {catalog,products,makerFor,price,labels} from '../../../lib/catalog';
import {pagePath} from '../../../config/site';
export function getStaticPaths(){return products.map((product,index)=>({params:{slug:product.slug},props:{product,index}}))}
const {product:p,index}=Astro.props;
const maker=makerFor(p), merchant=catalog.merchants.find(m=>m.id===p.merchantIds[0])!;
const notes=await getCollection('productNotes',({data})=>data.productId===p.id&&data.publishStatus==='published');
const Content=notes.length?(await render(notes[0])).Content:null;
const sourceIds=[...new Set([...p.sourceIds,...maker.sourceIds,...merchant.sourceIds,...merchant.shipping.sourceIds,...p.craftClassification.sourceIds])];
const craftNotes=(await getCollection('craftNotes',({data})=>data.publishStatus==='published')).filter(note=>p.craftIds.includes(note.data.craftId)&&note.body?.trim());
const specs=[['Object type',labels('productTypes',p.productType)],['Craft',labels('crafts',p.craftIds)],['Maker region',p.prefectureIds.length?labels('prefectures',p.prefectureIds)+' — workshop association; item-level origin not certified':'Manufacturing location unconfirmed'],['Materials',labels('materials',p.materialIds)],['Dimensions',p.size||'Not stated in the sources checked'],['Weight',p.weightPerPieceGrams===null?'Not stated — no lightness claim':p.weightPerPieceGrams+' g per piece'],['Hardware',p.findings||'Not stated in the sources checked'],['Fastening',p.fastening||'Exact construction unconfirmed'],['Classification',p.craftClassification.label]];
---
<Base title={p.title} description={p.editorialSummary} article updatedAt={p.lastVerifiedAt}><div class="wrap"><div class="breadcrumbs" style="padding-top:30px"><a href={pagePath()}>Home</a><span>/</span><a href={pagePath('objects/')}>Objects</a><span>/</span><span>{p.title}</span></div><Disclosure productIds={[p.id,...products.filter(v=>v.id!==p.id).slice(0,3).map(v=>v.id)]}/><div class="product-detail"><Pattern variant={index}/><div class="product-info"><p class="eyebrow">{labels('crafts',p.craftIds)} / {labels('productTypes',p.productType)}</p><h1>{p.title}</h1><p class="maker-name">Maker: {maker.name}</p><p lang="ja" class="muted">{p.originalTitle}</p><p>{p.editorialSummary}</p><p class="detail-price">{price(p)}</p><p class="price-note">{p.taxNote} · Checked {p.priceCheckedAt}. Shipping and import charges are separate.</p>{p.availability==='out_of_stock'&&<p class="notice"><strong>Sold out when checked.</strong> This is a reference listing. Ask the retailer about restocking.</p>}<RetailerLink productId={p.id}/><p class="price-note" style="margin-top:14px">Opens the official {merchant.id==='hamamatsuya'?'maker catalog in Japanese':'retailer product page in Japanese'}. This is an introduction, not an on-site purchase.</p></div></div><div class="detail-grid"><section><h2>The details we could verify.</h2><dl class="spec-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="price-note" style="margin-top:18px">Last researched {p.lastVerifiedAt}. A listing is not a stock guarantee.</p></section><div><section><h2>Why consider it?</h2><p>{p.whoItMaySuit}</p>{Content&&<div class="prose"><Content/></div>}<h2>Before you decide</h2><ul>{p.whatToCheck.map(v=><li>{v}</li>)}</ul></section></div></div><div class="detail-grid"><section><h2>The maker & the place</h2><p><a href={pagePath(`makers/${maker.id}/`)}>{maker.name}</a></p><p>{maker.productionNote}</p>{craftNotes.map(note=><p><a href={pagePath(`crafts/${note.id}/`)}>Understand {note.data.title} →</a></p>)}</section><section><h2>Buying from overseas</h2><p>{merchant.shipping.summary}</p><p><strong>Returns:</strong> {merchant.returns}</p><p class="muted">Country-specific delivery, total cost and the suitability of the fitting need confirmation with {merchant.name}. The retailer handles payment, taxes, delivery and order support.</p></section></div><div class="page-bottom"><Sources sourceIds={sourceIds}/></div><section class="related"><h2>Keep exploring.</h2><div class="product-grid">{products.filter(v=>v.id!==p.id).slice(0,3).map((product,i)=><ProductCard product={product} index={i}/>)}</div></section></div></Base>