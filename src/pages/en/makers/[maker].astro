---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Sources from '../../../components/Sources.astro';
import Disclosure from '../../../components/Disclosure.astro';
import {catalog,products} from '../../../lib/catalog';
export function getStaticPaths(){return catalog.makers.filter(m=>products.some(p=>p.makerId===m.id)).map(maker=>({params:{maker:maker.id},props:{maker}}))}
const {maker}=Astro.props;const items=products.filter(p=>p.makerId===maker.id);
---
<Base title={maker.name} description={maker.productionNote}><div class="wrap page-bottom"><header class="page-heading"><p class="eyebrow">MAKERS & PROVENANCE</p><h1>{maker.name}</h1><p>{maker.productionNote}</p></header><div class="notice"><strong>Location:</strong> {maker.location}. {maker.id.includes('unidentified')?'This is a transparency record for products whose maker is not identified, not a workshop profile.':'Our account is based on official published sources. We have not visited or interviewed the workshop.'}</div><p><a class="text-link" href={maker.url} target="_blank" rel="noopener noreferrer">View the official source ↗</a></p><Disclosure productIds={items.map(p=>p.id)}/><div class="product-grid">{items.map((p,i)=><ProductCard product={p} index={i}/>)}</div><div class="related"><Sources sourceIds={maker.sourceIds}/></div></div></Base>