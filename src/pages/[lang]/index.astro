---
import Base from '../../layouts/Base.astro';
import Pattern from '../../components/Pattern.astro';
import ProductCard from '../../components/ProductCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import Disclosure from '../../components/Disclosure.astro';
import {productsFor} from '../../lib/catalog';
import {contentFor,contentSlug} from '../../lib/content';
import {editorialImageFor} from '../../lib/editorial-images';
import {locales,t,type Locale} from '../../lib/i18n';
import {pagePath} from '../../config/site';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}))}
const {locale}=Astro.props as {locale:Locale};
const products=productsFor(locale);
const guides=(await contentFor('guides',locale)).sort((a,b)=>Number(Boolean(editorialImageFor(contentSlug(b))))-Number(Boolean(editorialImageFor(contentSlug(a))))).slice(0,4);
const featured=[products[0],products[1],products[3]].filter(Boolean);
const href=(route='')=>pagePath(route,locale);
---
<Base title={t(locale,'Japanese Craft Jewelry | Earrings & Maker Stories','日本の工芸ジュエリー・ピアスとイヤリングの案内')} locale={locale}><section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="tiny-square"></span>{t(locale,'JAPANESE CRAFT JEWELRY','日本の工芸ジュエリー')}</p><h1>{t(locale,'Japanese jewelry,','日本の工芸を、')}<br/><em>{t(locale,'rooted in craft.','身につける。')}</em></h1><p class="hero-intro">{t(locale,'A small piece. A world of making.','小さなジュエリーに、ものづくりの奥行きを。')}<br/>{t(locale,'Discover jewelry shaped by Japanese craft, and the makers, places and details behind each piece.','日本各地の技法から生まれるジュエリーを、作り手・産地・選ぶ前の確認点とともに紹介します。')}</p><a class="button" href={href('objects/')}>{t(locale,'Explore the jewelry','ジュエリーを見る')}<span aria-hidden="true">↗</span></a><a class="hero-secondary" href={href('journal/everyday-craft-earrings/')}>{t(locale,'New to craft jewelry? Start here','工芸ジュエリーの選び方から読む')}<span aria-hidden="true">→</span></a><div class="hero-footnote"><span>{t(locale,'CRAFT, ACROSS JAPAN','日本各地の、ものづくり')}</span><span>{t(locale,'Materials. Makers. Meaning.','素材・作り手・ものがたり')}</span></div></div><div class="hero-visual"><Pattern hero locale={locale}/><div class="visual-stamp"><span>{t(locale,'THE BEAUTY','ものづくりの')}<br/>{t(locale,'IS IN THE','美しさは')}</span><em>{t(locale,'details.','細部に。')}</em></div></div></section>
<div class="wrap intro-line"><span class="eyebrow">{t(locale,'A LITTLE LESS GUESSWORK','納得して選ぶために')}</span><p>{t(locale,'Know the maker. Understand the details.','作り手を知り、細部を確かめる。')}<br/>{t(locale,'Choose something that feels like you.','自分らしいひとつに出会う。')}</p></div>
<section class="wrap browse-section"><div class="section-heading"><h2>{t(locale,'Find your kind of jewelry.','自分に合うジュエリーを。')}</h2><a class="text-link" href={href('objects/')}>{t(locale,'View all jewelry','ジュエリー一覧へ')}<span aria-hidden="true">→</span></a></div><div class="type-links">{[['pierced-earrings','◌',t(locale,'Pierced earrings','ピアス'),t(locale,'Begin with the fitting and the details','金具と仕様を確かめて選ぶ')],['clip-on-earrings','⊂',t(locale,'Non-pierced earrings','イヤリング'),t(locale,'Find your non-pierced option','耳に穴を開けずに楽しむ')],['necklace','◇',t(locale,'Necklaces','ネックレス'),t(locale,'Explore a yosegi pendant','寄木細工のペンダントから')]].map(([type,icon,label,note])=><a href={href('objects/?type='+type)}><span class="type-icon" aria-hidden="true">{icon}</span><span>{label}<small>{note}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
<section class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">{t(locale,'THE CURRENT EDIT','いま紹介しているジュエリー')}</p><h2>{t(locale,'A closer look at yosegi.','寄木細工を、ジュエリーに。')}</h2></div><a class="text-link" href={href('objects/')}>{t(locale,`Explore all ${products.length} pieces`,`全${products.length}点を見る`)}<span aria-hidden="true">→</span></a></div><p class="section-intro">{t(locale,'Our current edit explores geometric woodwork in earrings and a pendant. Each researched introduction separates verified details from the questions still worth asking.','現在は、幾何学模様の木工を用いたピアス・イヤリング・ペンダントを紹介しています。一次情報で確認できたことと、購入前に聞いておきたいことを分けて整理しました。')}</p><Disclosure productIds={featured.map(p=>p.id)} locale={locale}/><div class="product-grid">{featured.map((p,i)=><ProductCard product={p} index={i} locale={locale}/>)}</div></section>
<section class="place-feature"><div class="wrap place-grid"><div class="place-graphic" aria-hidden="true"><span class="mountain mountain-one"></span><span class="mountain mountain-two"></span><span class="place-sun"></span><span class="place-coordinates">CRAFT / JAPAN<br/>日本のものづくり</span></div><div class="place-copy"><p class="eyebrow">{t(locale,'PLACES & PEOPLE','産地と作り手をたどる')}</p><h2>{t(locale,'A craft journey','日本各地の、')}<br/><em>{t(locale,'across Japan.','工芸と出会う。')}</em></h2><p>{t(locale,'Different places, different ways of making. Follow the techniques and workshop stories behind the jewelry, one researched region at a time.','産地ごとに異なる素材や技法。その土地の工房とジュエリーの関係を、調査できた地域から少しずつ紹介していきます。')}</p><p class="place-small">{t(locale,'Our first regional notes cover Hakone in Kanagawa. More regions will join as we verify makers, jewelry and sources.','最初の産地記事は神奈川県・箱根です。作り手や商品、根拠を確認できた産地から、全国へと広げていきます。')}</p><a class="button button-light" href={href('places/')}>{t(locale,'Explore the regions','産地をめぐる')}<span aria-hidden="true">↗</span></a></div></div></section>
<section class="wrap section-space"><div class="section-heading"><div><p class="eyebrow">{t(locale,'THE JOURNAL','読みもの')}</p><h2>{t(locale,'A little knowledge goes a long way.','知るほどに、選ぶ楽しさを。')}</h2></div><a class="text-link" href={href('journal/')}>{t(locale,'All field notes','すべての記事へ')}<span aria-hidden="true">→</span></a></div><div class="guide-grid">{guides.map((g,i)=><GuideCard guide={g} index={i} locale={locale}/>)}</div></section>
<section class="wrap trust-strip"><p class="eyebrow">{t(locale,'OUR EDITORIAL PROMISE','編集の約束')}</p><h2>{t(locale,'Curiosity, with the sources to match.','好奇心に、確かな根拠を。')}</h2><div class="trust-grid"><p><strong>{t(locale,'Facts you can trace.','根拠をたどれること。')}</strong>{t(locale,'Primary sources and a checked date accompany every piece.','商品ごとに一次情報と確認日を記録します。')}</p><p><strong>{t(locale,'Room for the unknown.','不明なことは、不明のまま。')}</strong>{t(locale,'No invented weights, wear tests, reviews or promises.','重量や使用感、レビューを作り上げません。')}</p><p><strong>{t(locale,'A clear way onwards.','購入先を明確に。')}</strong>{t(locale,'We guide you to the retailer, who handles the purchase.','購入手続きや発送は、リンク先の販売店が行います。')}</p></div><a class="text-link" href={href('editorial-policy/')}>{t(locale,'Read our approach','編集方針を読む')}<span aria-hidden="true">→</span></a></section></Base>
