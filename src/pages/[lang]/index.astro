---
import Base from '../../layouts/Base.astro';
import Pattern from '../../components/Pattern.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import Disclosure from '../../components/Disclosure.astro';
import {productsFor,price} from '../../lib/catalog';
import {productImageFor} from '../../lib/editorial-images';
import {selection} from '../../config/selection';
import {locales,t,type Locale} from '../../lib/i18n';
import {pagePath} from '../../config/site';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}))}
const {locale}=Astro.props as {locale:Locale};
const products=productsFor(locale);
const featured=selection.featuredProductIds.flatMap(id=>{const product=products.find(p=>p.id===id);return product&&product.availability!=='out_of_stock'?[product]:[]});
const hero=products.find(p=>p.id===selection.heroProductId)||products[0];
const heroImage=hero&&productImageFor(hero.id);
const href=(route='')=>pagePath(route,locale);
const kinds=[['pierced-earrings','◌',t(locale,'Pierced earrings','ピアス')],['clip-on-earrings','⊂',t(locale,'Non-pierced earrings','イヤリング')],['necklace','◇',t(locale,'Necklaces','ネックレス')],['bracelet','○',t(locale,'Bracelets','ブレスレット')]];
const materials=[['glass','◈',t(locale,'Glass','ガラス'),t(locale,'Color and light','透明感と、光の表情')],['porcelain','◐',t(locale,'Porcelain','陶磁器'),t(locale,'Sculptural shape and glaze','かたちと、つやを楽しむ')],['cotton','✿',t(locale,'Textile','布'),t(locale,'Color in delicate thread','糸で描く、花の彩り')],['silver','◌',t(locale,'Silver','銀'),t(locale,'Quiet metallic details','繊細な輝きを、ひとつ')],['enamel-glaze','◒',t(locale,'Cloisonné enamel','七宝'),t(locale,'Deep translucent colors','色の奥行きと、つや')],['wood','◇',t(locale,'Wood','木'),t(locale,'Warm geometric patterns','木の色と、幾何学の模様')]].filter(([id])=>products.some(product=>product.materialIds.includes(id)));
---
<Base title={t(locale,'Japanese Craft Jewelry | Earrings, Necklaces & Bracelets','日本の工芸ジュエリー｜ピアス・イヤリング・ネックレス')} description={t(locale,'Discover Japanese craft earrings, necklaces and bracelets in glass, porcelain, silver, textile and wood. Selected designs from across Japan with styling ideas.','ガラス、陶磁器、銀、布、七宝、木。日本各地の工芸ジュエリーを、デザインと装いのヒントから紹介。ピアスやイヤリング、ネックレスを素材から選べます。')} locale={locale}>
<section class="selection-hero wrap">
 <div class="selection-hero-copy"><p class="eyebrow">{t(locale,'THE JAPANESE JEWELRY SELECTION','日本の工芸ジュエリーをセレクト')}</p><h1>{t(locale,'Small pieces.','日本の工芸を、')}<br/><em>{t(locale,'A choice of your own.','いつもの装いに。')}</em></h1><p>{t(locale,'Glass that catches the light. Flowers drawn in thread. A small touch of silver. Discover Japanese craft jewelry with a color, shape and character of your own.','ガラスの透明感、糸で描く花、銀の小さな輝き。日本各地の工芸から、好きな色と、かたちを。いつもの装いに、あなたらしいひとつを。')}</p><div class="selection-actions"><a class="button" href="#selected-pieces">{t(locale,'Explore our picks','おすすめ商品を見る')}<span aria-hidden="true">↓</span></a><a class="text-link" href={href('objects/')}>{t(locale,'All jewelry','すべての商品')}<span aria-hidden="true">→</span></a></div><p class="selection-retailer-note">{t(locale,'Selected for the design. Shared with styling ideas.','デザインにひかれた理由と、装いのヒントを添えて。')}</p></div>
 <div class="selection-hero-image">{heroImage?<EditorialImage image={heroImage} locale={locale} priority/>:<Pattern hero locale={locale}/>} {hero&&<a class="selection-hero-product" href={href('objects/'+hero.slug+'/')}><span>{hero.title}<small>{t(locale,'View this piece','この商品を見る')} →</small></span><span>{price(hero,locale)}<small>{t(locale,'Checked ','確認：')}{hero.priceCheckedAt}</small></span></a>}</div>
</section>
<section class="wrap section-space" id="selected-pieces"><div class="section-heading"><div><p class="eyebrow">{t(locale,'OUR CURRENT PICKS','いまのおすすめ')}</p><h2>{t(locale,'Chosen for the details.','気になるひとつを、見つける。')}</h2></div><a class="text-link" href={href('objects/')}>{t(locale,'View the full selection','セレクトをすべて見る')}<span aria-hidden="true">→</span></a></div><p class="section-intro">{t(locale,'Textile flowers, silver blossoms and the glow of glass. Six picks with a different character for your everyday outfit.','布の花、銀の小花、ガラスと七宝の色。素材ごとに違う表情から、気になるひとつを見つけてください。')}</p><Disclosure productIds={featured.map(p=>p.id)} locale={locale}/><div class="product-grid">{featured.map((product,index)=><ProductCard product={product} index={index} locale={locale}/>)}</div></section>
<section class="wrap selection-categories"><div class="section-heading"><h2>{t(locale,'Find your kind.','種類から選ぶ。')}</h2></div><div class="type-links type-links-four">{kinds.map(([type,icon,label])=><a href={href('objects/?type='+type)}><span class="type-icon" aria-hidden="true">{icon}</span><span>{label}<small>{t(locale,products.filter(p=>p.productType.includes(type)).length+' selected pieces',products.filter(p=>p.productType.includes(type)).length+'点を掲載')}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
{materials.length>0&&<section class="wrap selection-categories section-space"><div class="section-heading"><h2>{t(locale,'Follow the material.','素材から選ぶ。')}</h2></div><div class="type-links">{materials.map(([id,icon,label,detail])=><a href={href('objects/?material='+id)}><span class="type-icon" aria-hidden="true">{icon}</span><span>{label}<small>{detail}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>}

<section class="selection-region"><div class="wrap selection-region-inner"><div><p class="eyebrow">{t(locale,'CRAFT, ACROSS JAPAN','日本各地から、ひとつずつ')}</p><h2>{t(locale,'Find jewelry by region.','産地から選ぶ。')}</h2><p>{t(locale,'A different place, a different expression of craft. Explore jewelry through its connections to workshops across Japan.','土地が変わると、ものづくりの表情も変わる。日本各地の工房とのつながりから、気になるジュエリーを見つけてみませんか。')}</p></div><a class="button button-light" href={href('places/')}>{t(locale,'Browse regions','産地別の商品を見る')}<span aria-hidden="true">↗</span></a></div></section>
<section class="wrap selection-promise"><p>{t(locale,'Designs to discover. Details you can trace.','ひかれるデザインに、確かめられる情報を。')}</p><a class="text-link" href={href('editorial-policy/')}>{t(locale,'How we select','セレクトの方針')}<span aria-hidden="true">→</span></a></section>
</Base>
