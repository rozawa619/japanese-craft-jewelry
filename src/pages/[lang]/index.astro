---
import Base from '../../layouts/Base.astro';
import Pattern from '../../components/Pattern.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import ProductCard from '../../components/ProductCard.astro';
import Disclosure from '../../components/Disclosure.astro';
import {productsFor,price} from '../../lib/catalog';
import {productImageFor} from '../../lib/editorial-images';
import {selection} from '../../config/selection';
import {locales,t,type Locale} from '../../lib/i18n';
import {pagePath} from '../../config/site';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}))}
const {locale}=Astro.props as {locale:Locale};
const products=productsFor(locale);
const featured=selection.featuredProductIds.flatMap(id=>{const product=products.find(p=>p.id===id);return product&&product.availability!=='out_of_stock'?[product]:[]});
const hero=products.find(p=>p.id===selection.heroProductId)||products[0];
const heroImage=hero&&productImageFor(hero.id);
const href=(route='')=>pagePath(route,locale);
const kinds=[['pierced-earrings','◌',t(locale,'Pierced earrings','ピアス')],['clip-on-earrings','⊂',t(locale,'Non-pierced earrings','イヤリング')],['necklace','◇',t(locale,'Necklaces','ネックレス')]];
---
<Base title={t(locale,'Japanese Craft Jewelry | Selected Earrings & Necklaces','日本の工芸ジュエリー｜おすすめのピアス・イヤリング・ネックレス')} description={t(locale,'A curated selection of Japanese craft jewelry. Discover earrings and necklaces, compare the details, and visit the official retailer for the piece you love.','日本各地の工芸ジュエリーをセレクト。おすすめのピアス・イヤリング・ネックレスから気になる商品を選び、仕様や価格を確かめて公式販売店へ。')} locale={locale}>
<section class="selection-hero wrap">
 <div class="selection-hero-copy"><p class="eyebrow">{t(locale,'THE JAPANESE JEWELRY SELECTION','日本の工芸ジュエリーをセレクト')}</p><h1>{t(locale,'Small pieces.','日本の工芸を、')}<br/><em>{t(locale,'A choice of your own.','いつもの装いに。')}</em></h1><p>{t(locale,'Earrings, clip-ons and necklaces with a connection to Japanese craft. Find a piece you love, explore its details, and visit the retailer.','ピアス、イヤリング、ネックレス。日本のものづくりを感じるジュエリーから、あなたらしいひとつを。気になる商品を選んで、販売店へ進めます。')}</p><div class="selection-actions"><a class="button" href="#selected-pieces">{t(locale,'Explore our picks','おすすめ商品を見る')}<span aria-hidden="true">↓</span></a><a class="text-link" href={href('objects/')}>{t(locale,'All jewelry','すべての商品')}<span aria-hidden="true">→</span></a></div><p class="selection-retailer-note">{t(locale,'Selected by Japanese Craft Jewelry. Purchases, payment and shipping are handled by the linked retailer.','当サイトは商品のセレクト・紹介を行います。購入・決済・発送はリンク先の販売店が対応します。')}</p></div>
 <div class="selection-hero-image">{heroImage?<EditorialImage image={heroImage} locale={locale} priority/>:<Pattern hero locale={locale}/>} {hero&&<a class="selection-hero-product" href={href('objects/'+hero.slug+'/')}><span>{hero.title}<small>{t(locale,'View this piece','この商品を見る')} →</small></span><span>{price(hero,locale)}<small>{t(locale,'Checked ','確認：')}{hero.priceCheckedAt}</small></span></a>}</div>
</section>
<section class="wrap selection-categories"><div class="section-heading"><h2>{t(locale,'Find your kind.','種類から選ぶ。')}</h2></div><div class="type-links">{kinds.map(([type,icon,label])=><a href={href('objects/?type='+type)}><span class="type-icon" aria-hidden="true">{icon}</span><span>{label}<small>{t(locale,products.filter(p=>p.productType.includes(type)).length+' selected pieces',products.filter(p=>p.productType.includes(type)).length+'点を掲載')}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
<section class="wrap section-space" id="selected-pieces"><div class="section-heading"><div><p class="eyebrow">{t(locale,'OUR CURRENT PICKS','いまのおすすめ')}</p><h2>{t(locale,'Chosen for the details.','気になるひとつを、見つける。')}</h2></div><a class="text-link" href={href('objects/')}>{t(locale,'View the full selection','セレクトをすべて見る')}<span aria-hidden="true">→</span></a></div><p class="section-intro">{t(locale,'Our first selection brings together geometric yosegi wood jewelry connected to Hakone. Product details explain what we selected, the source-checked facts and what to ask before ordering.','最初のセレクトは、箱根に関わる寄木のジュエリー。デザインの魅力、確認できた仕様、購入前の確認点を商品ごとにまとめています。')}</p><Disclosure productIds={featured.map(p=>p.id)} locale={locale}/><div class="product-grid">{featured.map((product,index)=><ProductCard product={product} index={index} locale={locale}/>)}</div></section>
<section class="selection-region"><div class="wrap selection-region-inner"><div><p class="eyebrow">{t(locale,'CRAFT, ACROSS JAPAN','日本各地から、ひとつずつ')}</p><h2>{t(locale,'Find jewelry by region.','産地から選ぶ。')}</h2><p>{t(locale,'Explore the selection through its workshop connections. We begin with Kanagawa and add more regions as products and sources are verified.','工房のつながりを手がかりに、ジュエリーを選ぶ。神奈川から始め、商品と根拠を確認できた産地へ広げていきます。')}</p></div><a class="button button-light" href={href('places/')}>{t(locale,'Browse regions','産地別の商品を見る')}<span aria-hidden="true">↗</span></a></div></section>
<section class="wrap selection-promise"><p>{t(locale,'Clear prices. Traceable details. A direct route to the retailer.','価格と確認日、確かな根拠、分かりやすい購入先。')}</p><a class="text-link" href={href('editorial-policy/')}>{t(locale,'How we select','セレクトの方針')}<span aria-hidden="true">→</span></a></section>
</Base>
