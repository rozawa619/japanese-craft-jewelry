---
import {render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import {site} from '../../config/site';
import {contentFor,contentSlug} from '../../lib/content';
import {locales,t} from '../../lib/i18n';
export async function getStaticPaths(){const paths=[];for(const locale of locales){for(const page of await contentFor('policies',locale))paths.push({params:{lang:locale,policy:contentSlug(page)},props:{page,locale}})}return paths}
const {page,locale}=Astro.props;const {Content}=await render(page);const key=contentSlug(page);
---
<Base title={page.data.title} description={page.data.description} updatedAt={page.data.updatedAt} locale={locale}><div class="article-wrap"><header class="page-heading"><p class="eyebrow">{t(locale,'THE WAY WE WORK','Japanese Craft Jewelryの運営方針')}</p><h1>{page.data.title}</h1><p>{page.data.description}</p></header><div class="article-meta">{t(locale,'Updated ','更新：')}{page.data.updatedAt}</div>{key==='affiliate-disclosure'&&<Disclosure scope="site" locale={locale}/>}<article class="prose"><Content/>{key==='about'&&<section><h2>{t(locale,'Operator','運営者')}</h2><p>{site.operatorName?t(locale,site.operatorName+' is responsible for this jewelry selection.','運営者：'+site.operatorName):t(locale,'Japanese Craft Jewelry is an independent editorial project. A named operator has not yet been provided for this preview.','Japanese Craft Jewelryは独立した編集プロジェクトです。このプレビューでは、運営責任者の公開表示名はまだ設定されていません。')}</p></section>}{key==='contact'&&<section class="contact-option">{site.contactEmail?<><h2>{t(locale,'Email the editor','編集部へのメール')}</h2><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></>:site.repositoryUrl?<><h2>{t(locale,'Editorial corrections','掲載情報の訂正')}</h2><p>{t(locale,'You can open a public issue on our project repository. A GitHub account is required. Do not include private or order information.','プロジェクトのGitHub Issuesから公開の訂正依頼を送れます。GitHubアカウントが必要です。個人情報や注文情報は書き込まないでください。')}</p><a href={site.repositoryUrl.replace(/\/$/,'')+'/issues/new'} target="_blank" rel="noopener noreferrer">{t(locale,'Send a correction via GitHub ↗','GitHubで訂正を依頼する ↗')}</a></>:<p>{t(locale,'No editorial contact channel is active in this preview. Orders and delivery questions should be directed to the retailer linked on the jewelry page.','このプレビューでは編集窓口がまだ設定されていません。注文や配送については、各商品ページの販売店へお問い合わせください。')}</p>}</section>}</article></div></Base>
