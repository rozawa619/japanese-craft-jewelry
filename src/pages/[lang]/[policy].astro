---
import {render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import AdvertisingPrivacyStatus from '../../components/AdvertisingPrivacyStatus.astro';
import Sources from '../../components/Sources.astro';
import {site} from '../../config/site';
import {contentFor,contentSlug} from '../../lib/content';
import {locales,t} from '../../lib/i18n';
export async function getStaticPaths(){const paths=[];for(const locale of locales){for(const page of await contentFor('policies',locale))paths.push({params:{lang:locale,policy:contentSlug(page)},props:{page,locale}})}return paths}
const {page,locale}=Astro.props;const {Content}=await render(page);const key=contentSlug(page);
---
<Base title={page.data.title} description={page.data.description} updatedAt={page.data.updatedAt} locale={locale}><div class="article-wrap"><header class="page-heading"><p class="eyebrow">{t(locale,'THE WAY WE WORK','Japanese Craft Jewelryの運営方針')}</p><h1>{page.data.title}</h1><p>{page.data.description}</p></header>{key==='affiliate-disclosure'&&<Disclosure scope="site" locale={locale}/>}<article class="prose">{key==='privacy'&&<AdvertisingPrivacyStatus locale={locale}/>}<Content/>{key==='about'&&<section><h2>{t(locale,'Operator','運営者')}</h2><p>{site.operatorName?t(locale,site.operatorName+' is responsible for this jewelry selection.','運営者：'+site.operatorName):t(locale,'Japanese Craft Jewelry is an independent editorial project. A named operator has not yet been provided for this preview.','Japanese Craft Jewelryは独立した編集プロジェクトです。このプレビューでは、運営責任者の公開表示名はまだ設定されていません。')}</p></section>}</article><Sources sourceIds={page.data.sourceIds} locale={locale}><p>{t(locale,'Last updated: ','最終更新：')}<time datetime={page.data.updatedAt}>{page.data.updatedAt}</time></p></Sources></div></Base>
