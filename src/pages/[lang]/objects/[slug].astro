---
import {render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Pattern from '../../../components/Pattern.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import {productImageFor} from '../../../lib/editorial-images';
import {storyFor} from '../../../lib/product-stories';
import Disclosure from '../../../components/Disclosure.astro';
import RetailerLink from '../../../components/RetailerLink.astro';
import Sources from '../../../components/Sources.astro';
import VisitGuide from '../../../components/VisitGuide.astro';
import ProductCard from '../../../components/ProductCard.astro';
import {catalogFor,productsFor,makerFor,price,labels,resolve,linksFor} from '../../../lib/catalog';
import {contentFor,contentSlug} from '../../../lib/content';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
export function getStaticPaths(){return locales.flatMap(locale=>productsFor(locale).map((product,index)=>({params:{lang:locale,slug:product.slug},props:{product,index,locale}})))}
const {product:p,index,locale}=Astro.props;
const catalog=catalogFor(locale),products=productsFor(locale),story=storyFor(p.id,locale);
const href=(route='')=>pagePath(route,locale);
const maker=makerFor(p,locale),merchant=catalog.merchants.find(m=>m.id===p.merchantIds[0])!;
const notes=(await contentFor('productNotes',locale)).filter(note=>note.data.productId===p.id);
const Content=notes.length?(await render(notes[0])).Content:null;
const sourceIds=[...new Set([...p.sourceIds,...maker.sourceIds,...merchant.sourceIds,...p.craftClassification.sourceIds])];
const craftNotes=(await contentFor('craftNotes',locale)).filter(note=>p.craftIds.includes(note.data.craftId)&&note.body?.trim());
const earJewelry=p.productType.some(type=>['pierced-earrings','clip-on-earrings'].includes(type));
const specs=[[t(locale,'Type','種類'),labels('productTypes',p.productType,locale)],[t(locale,'Materials','素材'),labels('materials',p.materialIds,locale)],[t(locale,'Size','サイズ'),p.size||t(locale,'Not listed in the official information','公式情報に記載なし')],[t(locale,'Weight','重さ'),p.weightPerPieceGrams===null?(earJewelry?t(locale,'Per-ear weight not confirmed','片耳の重さは未確認'):t(locale,'Weight not confirmed','重さは未確認')):p.weightPerPieceGrams+(earJewelry?t(locale,' g per piece','g（片側）'):t(locale,' g','g'))],[t(locale,'Hardware','金具素材'),p.findings||t(locale,'Not listed in the official information','公式情報に記載なし')],[t(locale,'Fastening','留め方'),p.fastening||t(locale,'Not listed in the official information','公式情報に記載なし')]].filter(([label])=>earJewelry||p.weightPerPieceGrams!==null||label!==t(locale,'Weight','重さ'));
const image=productImageFor(p.id);
const candidates=products.filter(v=>v.id!==p.id&&v.availability!=='out_of_stock');
const related:typeof candidates=[];
const seenMaterials=new Set(p.materialIds);
for(const candidate of candidates){const material=candidate.materialIds[0];if(material&&!seenMaterials.has(material)){related.push(candidate);seenMaterials.add(material)}if(related.length===3)break}
for(const candidate of candidates){if(related.length===3)break;if(!related.some(item=>item.id===candidate.id))related.push(candidate)}
const hasDestination=linksFor([p.id],locale).some(link=>resolve(link));
const catalogLink=merchant.id==='hamamatsuya';
const destinationLabel=p.availability==='out_of_stock'?t(locale,'View the official listing','公式の商品情報を見る'):catalogLink?t(locale,'Explore the maker’s designs',p.productType.includes('necklace')?'工房でペンダントを見る':p.productType.includes('clip-on-earrings')?'工房でイヤリングを見る':'工房でピアスを見る'):t(locale,'See the official product page','公式サイトでこの商品を見る');
const destinationNote=t(locale,'Opens the official website in a new tab.','公式サイトが新しいタブで開きます。');
---
<Base title={p.title} description={p.editorialSummary} locale={locale} socialImage={image||false}>
<div class="wrap product-shopping-page" data-product-page>
 <div class="breadcrumbs purchase-breadcrumbs"><a href={href('objects/')}>{t(locale,'The selection','商品セレクト')}</a><span>/</span><span>{p.title}</span></div>
 <section class="purchase-hero" data-product-intro>
  <header class="purchase-intro"><p class="eyebrow">{labels('crafts',p.craftIds,locale)} / {labels('productTypes',p.productType,locale)}</p><p class="purchase-product-name">{p.title}</p><h1>{story.headline}</h1></header>
  <div class="purchase-visual">{image?<EditorialImage image={image} locale={locale} priority/>:<Pattern variant={index} locale={locale}/>}</div>
  <div class="purchase-buy"><p class="purchase-standfirst">{story.standfirst}</p><div class="purchase-price-row"><p class="purchase-price" data-product-price>{price(p,locale)}</p><span>{t(locale,'Reference price','参考価格')}</span></div><p class="purchase-price-note">{t(locale,'Checked ','確認：')}{p.priceCheckedAt}</p>
   {p.availability==='out_of_stock'&&<p class="purchase-stock-note">{t(locale,'Out of stock when checked.','確認時点では欠品しています。')}</p>}
   <Disclosure productIds={[p.id,...related.map(v=>v.id)]} locale={locale} compact/>
   <div class="purchase-primary" data-product-primary-cta><RetailerLink productId={p.id} locale={locale} label={destinationLabel}/></div><p class="purchase-destination-note">{destinationNote}</p>
   <ul class="purchase-highlights">{story.highlights.map(highlight=><li>{highlight}</li>)}</ul>
  </div>
 </section>
 <section class="purchase-story" aria-labelledby="why-this-piece"><div><p class="eyebrow">{t(locale,'WHY WE PICKED IT','このひとつを選んだ理由')}</p><h2 id="why-this-piece">{t(locale,'A detail to fall for.','惹かれる、その理由。')}</h2></div><div class="purchase-story-copy">{Content&&<div class="prose"><Content/></div>}</div></section>
 <section class="purchase-outfit" aria-labelledby="outfit-title"><div><p class="eyebrow">{t(locale,'PICTURE YOUR OUTFIT','こんな装いの日に')}</p><h2 id="outfit-title">{story.outfit.title}</h2></div><div><p>{story.outfit.body}</p></div></section>
 <VisitGuide productId={p.id} locale={locale}/>
 <section class="purchase-next"><div><h2>{t(locale,'Found a detail you love?','気になったら、お店で。')}</h2><p>{t(locale,'Take a closer look at the design on its official page.','気になるデザインを、公式サイトでも。')}</p></div><div><RetailerLink productId={p.id} locale={locale} label={destinationLabel}/><p class="purchase-destination-note">{destinationNote}</p></div></section>
 <div class="purchase-information">
  <details class="purchase-details" data-product-details><summary>{t(locale,'Materials, size & fittings','素材・サイズ・金具について')}</summary><div class="purchase-details-body"><dl class="spec-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><h2>{t(locale,'Materials & finish notes','素材・仕上げの補足')}</h2><ul>{p.whatToCheck.map(item=><li>{item}</li>)}</ul><p class="purchase-price-note">{t(locale,'Product information checked ','商品情報の確認：')}{p.lastVerifiedAt}</p></div></details>
  <details class="purchase-details"><summary>{t(locale,'Maker, craft & provenance','作り手・工芸・産地について')}</summary><div class="purchase-details-body"><h2><a href={href('makers/'+maker.id+'/')}>{maker.name}</a></h2><p>{maker.productionNote}</p><p>{p.craftClassification.label}</p>{craftNotes.map(note=><p><a href={href('crafts/'+contentSlug(note)+'/')}>{note.data.title} →</a></p>)}</div></details>
  <details class="purchase-details"><summary>{t(locale,'Sources & information checks','出典・情報の確認について')}</summary><div class="purchase-details-body"><Sources sourceIds={sourceIds} locale={locale}/></div></details>
 </div>
 <section class="related purchase-related"><h2>{t(locale,'More pieces to love.','こちらのジュエリーも。')}</h2><div class="product-grid">{related.map((product,i)=><ProductCard product={product} index={i} locale={locale}/>)}</div></section>
 {hasDestination&&<aside class="product-sticky-cta" data-product-sticky-cta hidden aria-label={t(locale,'Selected piece and retailer','選択中の商品と販売店')}><div><span class="sticky-product-name">{p.title}</span><strong>{price(p,locale)}</strong></div><RetailerLink productId={p.id} locale={locale} label={catalogLink?t(locale,'View at maker','工房で見る'):t(locale,'View at retailer','販売店で見る')}/></aside>}
</div>
<script>
 const sticky=document.querySelector<HTMLElement>('[data-product-sticky-cta]');
 const primary=document.querySelector<HTMLElement>('[data-product-primary-cta]');
 const footer=document.querySelector<HTMLElement>('.site-footer');
 if(sticky&&primary){
  let queued=false;
  const update=()=>{sticky.hidden=!matchMedia('(max-width: 720px)').matches||primary.getBoundingClientRect().bottom>=0||!!(footer&&footer.getBoundingClientRect().top<innerHeight)};
  addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(()=>{queued=false;update()})}},{passive:true});
  addEventListener('resize',update);document.addEventListener('toggle',update,true);update();
 }
</script>
</Base>
