---
import {render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Pattern from '../../../components/Pattern.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import {productImageFor} from '../../../lib/editorial-images';
import Disclosure from '../../../components/Disclosure.astro';
import RetailerLink from '../../../components/RetailerLink.astro';
import Sources from '../../../components/Sources.astro';
import ProductCard from '../../../components/ProductCard.astro';
import {catalogFor,productsFor,makerFor,price,labels} from '../../../lib/catalog';
import {contentFor,contentSlug} from '../../../lib/content';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
export function getStaticPaths(){return locales.flatMap(locale=>productsFor(locale).map((product,index)=>({params:{lang:locale,slug:product.slug},props:{product,index,locale}})))}
const {product:p,index,locale}=Astro.props;const catalog=catalogFor(locale),products=productsFor(locale);
const href=(route='')=>pagePath(route,locale);
const maker=makerFor(p,locale),merchant=catalog.merchants.find(m=>m.id===p.merchantIds[0])!;
const notes=(await contentFor('productNotes',locale)).filter(note=>note.data.productId===p.id);
const Content=notes.length?(await render(notes[0])).Content:null;
const sourceIds=[...new Set([...p.sourceIds,...maker.sourceIds,...merchant.sourceIds,...merchant.shipping.sourceIds,...p.craftClassification.sourceIds])];
const craftNotes=(await contentFor('craftNotes',locale)).filter(note=>p.craftIds.includes(note.data.craftId)&&note.body?.trim());
const specs=[[t(locale,'Jewelry type','種類'),labels('productTypes',p.productType,locale)],[t(locale,'Craft','技法'),labels('crafts',p.craftIds,locale)],[t(locale,'Maker region','工房の関連産地'),p.prefectureIds.length?labels('prefectures',p.prefectureIds,locale)+t(locale,' — workshop association; item-level origin not certified','（工房所在地との関連。商品単位の製造地認証ではありません）'):t(locale,'Manufacturing location unconfirmed','個別商品の製造地は未確認')],[t(locale,'Materials','素材'),labels('materials',p.materialIds,locale)],[t(locale,'Dimensions','寸法'),p.size||t(locale,'Not stated in the sources checked','確認した資料に記載なし')],[t(locale,'Weight','重量'),p.weightPerPieceGrams===null?t(locale,'Not stated — no lightness claim','記載なし。軽さは評価していません'):p.weightPerPieceGrams+t(locale,' g per piece','g（片側）')],[t(locale,'Hardware','金具素材'),p.findings||t(locale,'Not stated in the sources checked','確認した資料に記載なし')],[t(locale,'Fastening','留め方'),p.fastening||t(locale,'Exact construction unconfirmed','詳細な構造は未確認')],[t(locale,'Classification','工芸の位置づけ'),p.craftClassification.label]];
const image=productImageFor(p.id);
const related=products.filter(v=>v.id!==p.id).slice(0,3);
---
<Base title={p.title} description={p.editorialSummary} locale={locale}><div class="wrap"><div class="breadcrumbs product-breadcrumbs"><a href={href()}>{t(locale,'Home','トップ')}</a><span>/</span><a href={href('objects/')}>{t(locale,'Jewelry','ジュエリー')}</a><span>/</span><span>{p.title}</span></div><Disclosure productIds={[p.id,...related.map(v=>v.id)]} locale={locale}/><div class="product-detail">{image?<div class="product-styling"><EditorialImage image={image} locale={locale} priority/></div>:<Pattern variant={index} locale={locale}/>}<div class="product-info"><p class="eyebrow">{labels('crafts',p.craftIds,locale)} / {labels('productTypes',p.productType,locale)}</p><h1>{p.title}</h1><p class="maker-name">{t(locale,'Maker: ','作り手：')}{maker.name}</p><p lang="ja" class="muted">{p.originalTitle}</p><p>{p.editorialSummary}</p><p class="detail-price">{price(p,locale)}</p><p class="price-note">{p.taxNote} · {t(locale,`Checked ${p.priceCheckedAt}. Shipping and import charges are separate.`,`${p.priceCheckedAt}確認。送料・輸入時の費用は別途ご確認ください。`)}</p>{p.availability==='out_of_stock'&&<p class="notice"><strong>{t(locale,'Sold out when checked.','確認時点で欠品しています。')}</strong> {t(locale,'This is a reference listing. Ask the retailer about restocking.','参考情報として掲載しています。再入荷については販売店へお問い合わせください。')}</p>}<RetailerLink productId={p.id} locale={locale}/><p class="price-note retailer-navigation-note">{t(locale,merchant.id==='hamamatsuya'?'Opens the official maker catalog in Japanese. This is an introduction, not an on-site purchase.':'Opens the official retailer product page in Japanese. This is an introduction, not an on-site purchase.',merchant.id==='hamamatsuya'?'公式の工房カタログ（日本語）が開きます。当サイトでの販売ではありません。':'公式販売店の商品ページ（日本語）が開きます。当サイトでの販売ではありません。')}</p></div></div><div class="detail-grid"><section><h2>{t(locale,'The details we could verify.','確認できた仕様。')}</h2><dl class="spec-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="price-note research-date-note">{t(locale,`Last researched ${p.lastVerifiedAt}. A listing is not a stock guarantee.`,`最終確認：${p.lastVerifiedAt}。掲載は在庫を保証するものではありません。`)}</p></section><div><section><h2>{t(locale,'Selected for the details.','セレクトのポイント。')}</h2><p>{p.whoItMaySuit}</p>{Content&&<div class="prose"><Content/></div>}<h2>{t(locale,'Before you decide','購入前に確認したいこと')}</h2><ul>{p.whatToCheck.map(v=><li>{v}</li>)}</ul></section></div></div><div class="detail-grid"><section><h2>{t(locale,'The maker & the place','作り手と産地')}</h2><p><a href={href(`makers/${maker.id}/`)}>{maker.name}</a></p><p>{maker.productionNote}</p>{craftNotes.map(note=><p><a href={href(`crafts/${contentSlug(note)}/`)}>{t(locale,`Understand ${note.data.title}`,note.data.title+'を知る')} →</a></p>)}</section><section><h2>{t(locale,'Buying from overseas','配送・海外からの購入について')}</h2><p>{merchant.shipping.summary}</p><p><strong>{t(locale,'Returns:','返品：')}</strong> {merchant.returns}</p><p class="muted">{t(locale,`Country-specific delivery, total cost and fitting details need confirmation with ${merchant.name}. The retailer handles payment, taxes, delivery and order support.`,`配送先の国・地域、総額、金具の詳細は${merchant.name}へご確認ください。決済・税金・発送・注文対応は販売店が行います。`)}</p></section></div><div class="page-bottom"><Sources sourceIds={sourceIds} locale={locale}/></div><section class="related"><h2>{t(locale,'Keep exploring.','ほかのジュエリーも。')}</h2><div class="product-grid">{related.map((product,i)=><ProductCard product={product} index={i} locale={locale}/>)}</div></section></div></Base>

<style>
 .product-styling{min-width:0}
 .product-styling :global(.editorial-image){margin:0}
 .product-styling :global(.editorial-image img){aspect-ratio:1;object-position:56% 40%}
 @media(max-width:720px){.product-styling :global(.editorial-image img){aspect-ratio:3/2}}
</style>
