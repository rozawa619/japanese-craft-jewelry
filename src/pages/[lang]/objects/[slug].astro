---
import {render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import OfficialPreview from '../../../components/OfficialPreview.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import {productImageFor} from '../../../lib/editorial-images';
import {storyFor} from '../../../lib/product-stories';
import Disclosure from '../../../components/Disclosure.astro';
import MarketPrice from '../../../components/MarketPrice.astro';
import MarketPurchaseLink from '../../../components/MarketPurchaseLink.astro';
import Sources from '../../../components/Sources.astro';
import VisitGuide from '../../../components/VisitGuide.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ChoiceDetails from '../../../components/ChoiceDetails.astro';
import SelectionDecision from '../../../components/SelectionDecision.astro';
import ProductBuyingGuide from '../../../components/ProductBuyingGuide.astro';
import ProductDetailImage from '../../../components/ProductDetailImage.astro';
import {productDetailImageFor} from '../../../lib/product-detail-images';
import {buyingGuideFor} from '../../../lib/product-buying-guides';
import PurchaseEvidence from '../../../components/PurchaseEvidence.astro';
import {selectionNoteFor} from '../../../lib/selection-notes';
import {catalogFor,productsFor,makerFor,labels} from '../../../lib/catalog';
import {marketPricesFor,formatMarketPrice} from '../../../lib/market-prices';
import {purchaseEvidenceFor} from '../../../lib/purchase-evidence';
import {contentFor,contentSlug} from '../../../lib/content';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
import {productSearchMetadata} from '../../../lib/seo';
import {site} from '../../../config/site';
export function getStaticPaths(){return locales.flatMap(locale=>productsFor(locale).map(product=>({params:{lang:locale,slug:product.slug},props:{product,locale}})))}
const {product:p,locale}=Astro.props;
const catalog=catalogFor(locale),products=productsFor(locale),story=storyFor(p.id,locale);
const href=(route='')=>pagePath(route,locale);
const maker=makerFor(p,locale),merchant=catalog.merchants.find(m=>m.id===p.merchantIds[0])!;
const notes=(await contentFor('productNotes',locale)).filter(note=>note.data.productId===p.id);
const Content=notes.length?(await render(notes[0])).Content:null;
const choiceNote=selectionNoteFor(p.id,locale);
const buyingGuide=buyingGuideFor(p,locale);
const sourceIds=[...new Set([...p.sourceIds,...maker.sourceIds,...merchant.sourceIds,...p.craftClassification.sourceIds,...choiceNote.sourceIds,...buyingGuide.sourceIds])];
const craftNotes=(await contentFor('craftNotes',locale)).filter(note=>p.craftIds.includes(note.data.craftId)&&note.body?.trim());
const earJewelry=p.productType.some(type=>['pierced-earrings','clip-on-earrings','ear-cuff'].includes(type));
const specs=[[t(locale,'Type','種類'),labels('productTypes',p.productType,locale)],[t(locale,'Materials','素材'),labels('materials',p.materialIds,locale)],[t(locale,'Size','サイズ'),p.size||t(locale,'Not listed in the official information','公式情報に記載なし')],[t(locale,'Weight','重さ'),p.weightPerPieceGrams===null?(earJewelry?t(locale,'Per-ear weight not confirmed','片耳の重さは未確認'):t(locale,'Weight not confirmed','重さは未確認')):p.weightPerPieceGrams+(earJewelry?t(locale,' g per piece','g（片側）'):t(locale,' g','g'))],[t(locale,'Hardware','金具素材'),p.findings||t(locale,'Not listed in the official information','公式情報に記載なし')],[t(locale,'Fastening','留め方'),p.fastening||t(locale,'Not listed in the official information','公式情報に記載なし')]].filter(([label])=>earJewelry||p.weightPerPieceGrams!==null||label!==t(locale,'Weight','重さ'));
const image=productImageFor(p.id);
const detailImage=productDetailImageFor(p.id);
const search=productSearchMetadata(p,locale,labels('crafts',p.craftIds,locale));
const searchBreadcrumbs=site.url?[{name:t(locale,'The selection','商品セレクト'),url:new URL(href('objects/'),site.url).href},{name:p.title,url:new URL(href('objects/'+p.slug+'/'),site.url).href}]:undefined;
const candidates=products.filter(v=>v.id!==p.id&&v.availability!=='out_of_stock');
const related:typeof candidates=[];
const seenMaterials=new Set(p.materialIds);
for(const candidate of candidates){const material=candidate.materialIds[0];if(material&&!seenMaterials.has(material)){related.push(candidate);seenMaterials.add(material)}if(related.length===3)break}
for(const candidate of candidates){if(related.length===3)break;if(!related.some(item=>item.id===candidate.id))related.push(candidate)}
const markets=marketPricesFor(p.id);
const purchaseEvidence=purchaseEvidenceFor(p.id);
const hasRetailEvidence=purchaseEvidence.kind==='retail-and-catalog';
const allSourceIds=[...new Set([...sourceIds,...(markets.japan?.sourceIds||[]),...(markets.international?.sourceIds||[]),...purchaseEvidence.sourceIds])];
const hasDestination=markets.japanLinks.length>0;
const showInternational=!!markets.international||markets.internationalLinks.length>0;
const visibleMarketLinkIds=[...markets.japanLinks,...(showInternational?markets.internationalLinks:[]),...related.flatMap(product=>marketPricesFor(product.id).japanLinks)].map(link=>link.id);
const destinationNote=t(locale,'Opens the official website in a new tab.','公式サイトが新しいタブで開きます。');
---
<Base title={search.title} description={search.description} locale={locale} socialImage={image||false} breadcrumbs={searchBreadcrumbs} subjectName={p.title}>
<div class="wrap product-shopping-page" data-product-page>
 <div class="breadcrumbs purchase-breadcrumbs"><a href={href('objects/')}>{t(locale,'The selection','商品セレクト')}</a><span>/</span><span>{p.title}</span></div>
 <section class="purchase-hero" data-product-intro>
  <header class="purchase-intro"><p class="eyebrow">{labels('crafts',p.craftIds,locale)} / {labels('productTypes',p.productType,locale)}</p><p class="purchase-product-name">{p.title}</p><h1>{story.headline}</h1></header>
  <div class="purchase-visual">{image?<EditorialImage image={image} locale={locale} priority/>:<OfficialPreview product={p} locale={locale}/>}{hasDestination&&<a class="official-visual-link" href={markets.japanLinks[0]?.url} target="_blank" rel="noopener noreferrer" data-official-visual-url>{t(locale,'See the actual design and details on the official page','実物のデザイン・詳細を公式ページで見る')} <span aria-hidden="true">↗</span><span class="sr-only">{t(locale,' (opens in a new tab)','（新しいタブで開く）')}</span></a>}</div>
  <div class="purchase-buy"><p class="purchase-standfirst">{story.standfirst}</p>
   <Disclosure productIds={[p.id,...related.map(v=>v.id)]} locale={locale} linkIds={visibleMarketLinkIds} compact/>
   <div class="purchase-market-block" data-market-section="japan">
    <MarketPrice productId={p.id} locale={locale} variant="detail" primary/>
    <p class="purchase-market-note">{hasRetailEvidence
     ?t(locale,'Check current prices and stock with the shop.','現在の価格と在庫は取扱店でご確認ください。')
     :t(locale,'Online reference price in Japan. In-store price is not confirmed.','日本向け通販の参考価格です。実店舗の価格は未確認です。')}</p>
    <PurchaseEvidence productId={p.id} locale={locale}/>
    {p.availability==='out_of_stock'&&<p class="purchase-stock-note">{t(locale,'Out of stock when checked.','確認時点では欠品しています。')}</p>}
    <div class="purchase-primary" data-product-primary-cta><MarketPurchaseLink productId={p.id} locale={locale}/></div>
    <a class="market-visit-link" href={'#official-and-visit-'+p.id} data-price-visit-link>{hasRetailEvidence
     ?t(locale,'See where to find it','取扱店を見る')
     :t(locale,'Shop information & visiting Japan','日本のお店・訪問の案内を見る')} <span aria-hidden="true">↓</span></a>
    {markets.japanLinks.map(link=><p class="market-official-source"><a href={link.url} target="_blank" rel="noopener noreferrer" data-japan-official-url={link.id}>{t(locale,'Explore the official details & options','公式の仕様・選択肢を見る')} <span aria-hidden="true">↗</span><span class="sr-only">{t(locale,' (official product information, opens in a new tab)','（公式商品情報、新しいタブで開く）')}</span></a></p>)}
   </div>
   {showInternational&&<section class="purchase-market-international" data-market-section="international" aria-label={t(locale,'International store price and link','海外通販の価格とリンク')}>
    <MarketPrice productId={p.id} locale={locale} market="international"/>
    <p class="purchase-market-note">{t(locale,'A separate storefront price, not a currency conversion.','別ストアの表示価格です。為替換算額ではありません。')}</p>
    <MarketPurchaseLink productId={p.id} locale={locale} market="international" label={t(locale,'Visit international store','海外向け公式ストアへ')}/>
   </section>}
   <ul class="purchase-highlights">{story.highlights.map(highlight=><li>{highlight}</li>)}</ul>
  </div>
 </section>
 <SelectionDecision productId={p.id} locale={locale}/>
 <section class="purchase-story" aria-labelledby="why-this-piece"><div><p class="eyebrow">{t(locale,'WHY WE PICKED IT','このひとつを選んだ理由')}</p><h2 id="why-this-piece">{t(locale,'A detail to fall for.','惹かれる、その理由。')}</h2></div><div class="purchase-story-copy purchase-story-with-art"><ProductDetailImage image={detailImage} locale={locale} officialUrl={markets.japanLinks[0]?.url}/>{Content&&<div class="prose"><Content/></div>}</div></section>
 <section class="purchase-outfit" aria-labelledby="outfit-title"><div><p class="eyebrow">{t(locale,'PICTURE YOUR OUTFIT','こんな装いの日に')}</p><h2 id="outfit-title">{story.outfit.title}</h2></div><div><p>{story.outfit.body}</p></div></section>
 <ChoiceDetails productId={p.id} locale={locale}/>
 <ProductBuyingGuide product={p} locale={locale}/>
 <VisitGuide productId={p.id} locale={locale}/>
 <section class="purchase-next"><div><h2>{t(locale,'Found a detail you love?','気になったら、お店で。')}</h2><p>{t(locale,'Take a closer look on the Japan official listing.','日本向けの公式ページで、気になるデザインをもう一度。')}</p></div><div><MarketPurchaseLink productId={p.id} locale={locale}/><p class="purchase-destination-note">{destinationNote}</p></div></section>
 <div class="purchase-information">
  <details class="purchase-details" data-product-details><summary>{t(locale,'Materials, size & fittings','素材・サイズ・金具について')}</summary><div class="purchase-details-body"><dl class="spec-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><h2>{t(locale,'Materials & finish notes','素材・仕上げの補足')}</h2><ul>{p.whatToCheck.map(item=><li>{item}</li>)}</ul></div></details>
  <details class="purchase-details"><summary>{t(locale,'Maker, craft & provenance','作り手・工芸・産地について')}</summary><div class="purchase-details-body"><h2><a href={href('makers/'+maker.id+'/')}>{maker.name}</a></h2><p>{maker.productionNote}</p><p>{p.craftClassification.label}</p>{craftNotes.map(note=><p><a href={href('crafts/'+contentSlug(note)+'/')}>{note.data.title} →</a></p>)}</div></details>
  <Sources sourceIds={allSourceIds} locale={locale} id="product-sources" className="purchase-details">
   <section class="information-checks" data-information-checks aria-label={t(locale,'Information checks','情報の確認日')}>
    <h2>{t(locale,'Information checks','情報の確認日')}</h2>
    <dl><div><dt>{t(locale,'Product information','商品情報')}</dt><dd><time datetime={p.lastVerifiedAt}>{p.lastVerifiedAt}</time></dd></div>{(['japan','international'] as const).map(market=>{const value=markets[market];return value&&<div data-market-check={market}><dt>{market==='japan'?t(locale,'Japan reference price','国内参考価格'):t(locale,'International store price','海外通販の参考価格')}</dt><dd>{formatMarketPrice(value,locale)}{value.checkedAt&&<> · <time datetime={value.checkedAt}>{value.checkedAt}</time></>}</dd></div>})}</dl>
   </section>
  </Sources>
 </div>
 <section class="related purchase-related"><h2>{t(locale,'More pieces to love.','こちらのジュエリーも。')}</h2><div class="product-grid">{related.map((product,i)=><ProductCard product={product} index={i} locale={locale}/>)}</div></section>
 {hasDestination&&<aside class="product-sticky-cta" data-product-sticky-cta hidden aria-label={t(locale,'Japan reference price and official listing','日本向け参考価格と公式ページ')}><div><span class="sticky-product-name">{p.title}</span><MarketPrice productId={p.id} locale={locale} variant="sticky"/></div><MarketPurchaseLink productId={p.id} locale={locale}/></aside>}
</div>
<script>
 const sticky=document.querySelector<HTMLElement>('[data-product-sticky-cta]');
 const primary=document.querySelector<HTMLElement>('[data-product-primary-cta]');
 const footer=document.querySelector<HTMLElement>('.site-footer');
 if(sticky&&primary){
  let queued=false;
  const update=()=>{sticky.hidden=!matchMedia('(max-width: 720px)').matches||primary.getBoundingClientRect().bottom>=0||!!(footer&&footer.getBoundingClientRect().top<innerHeight)};
  addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(()=>{queued=false;update()})}},{passive:true});
  addEventListener('resize',update);document.addEventListener('toggle',update,true);update();
 }
</script>
<style>
 .purchase-story{grid-template-columns:1fr;gap:26px}.purchase-story-with-art{display:grid;grid-template-columns:minmax(220px,300px) minmax(0,1fr);gap:40px;align-items:start}.purchase-story-with-art .prose{min-width:0}
 @media(max-width:720px){.purchase-story-with-art{grid-template-columns:1fr;gap:22px}}
 .official-visual-link{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:48px;font-size:11px;line-height:1.7;padding:13px 16px;border:1px solid var(--line);border-top:0;text-decoration:none}.official-visual-link:hover{background:#eeeee5}
 .purchase-market-block{padding-top:3px}
 .purchase-market-note{font-size:10px;line-height:1.75;color:var(--muted);margin:10px 0 14px}
 .market-official-source{margin:9px 0 0;font-size:10px;line-height:1.7;color:var(--muted);overflow-wrap:anywhere}
 .market-visit-link{display:inline-flex;align-items:center;gap:16px;min-height:44px;font-size:.875rem;line-height:1.6;margin-top:7px;text-decoration:none;border-bottom:1px solid var(--line)}
 .market-visit-link:hover{color:var(--accent);border-color:var(--accent)}
 .purchase-market-international{border:1px solid var(--line);background:#eeeee5;padding:17px 18px;margin-top:22px}
 .purchase-market-international :global(.retailer-link){display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:44px;background:transparent;color:var(--ink);padding:11px 13px;border:1px solid var(--forest);font-size:12px}
 .purchase-market-international .purchase-market-note{margin:9px 0 12px}
 @media(max-width:720px){.purchase-market-international{padding:15px;margin-top:18px}.market-official-source{font-size:9px}.purchase-market-note{font-size:10px}}
</style>
</Base>
