---
import {render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Pattern from '../../../components/Pattern.astro';
import EditorialImage from '../../../components/EditorialImage.astro';
import {productImageFor} from '../../../lib/editorial-images';
import {storyFor} from '../../../lib/product-stories';
import Disclosure from '../../../components/Disclosure.astro';
import RetailerLink from '../../../components/RetailerLink.astro';
import Sources from '../../../components/Sources.astro';
import ProductCard from '../../../components/ProductCard.astro';
import {catalogFor,productsFor,makerFor,price,labels,resolve} from '../../../lib/catalog';
import {contentFor,contentSlug} from '../../../lib/content';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
export function getStaticPaths(){return locales.flatMap(locale=>productsFor(locale).map((product,index)=>({params:{lang:locale,slug:product.slug},props:{product,index,locale}})))}
const {product:p,index,locale}=Astro.props;
const catalog=catalogFor(locale),products=productsFor(locale),story=storyFor(p.id,locale);
const href=(route='')=>pagePath(route,locale);
const maker=makerFor(p,locale),merchant=catalog.merchants.find(m=>m.id===p.merchantIds[0])!;
const notes=(await contentFor('productNotes',locale)).filter(note=>note.data.productId===p.id);
const Content=notes.length?(await render(notes[0])).Content:null;
const sourceIds=[...new Set([...p.sourceIds,...maker.sourceIds,...merchant.sourceIds,...merchant.shipping.sourceIds,...p.craftClassification.sourceIds])];
const craftNotes=(await contentFor('craftNotes',locale)).filter(note=>p.craftIds.includes(note.data.craftId)&&note.body?.trim());
const specs=[[t(locale,'Type','種類'),labels('productTypes',p.productType,locale)],[t(locale,'Materials','素材'),labels('materials',p.materialIds,locale)],[t(locale,'Size','サイズ'),p.size||t(locale,'Ask the retailer','販売店へお問い合わせください')],[t(locale,'Weight','重さ'),p.weightPerPieceGrams===null?t(locale,'Ask the retailer','販売店へお問い合わせください'):p.weightPerPieceGrams+t(locale,' g per piece','g（片側）')],[t(locale,'Hardware','金具素材'),p.findings||t(locale,'Ask the retailer','販売店へお問い合わせください')],[t(locale,'Fastening','留め方'),p.fastening||t(locale,'Ask the retailer for the exact fitting','詳細は販売店へお問い合わせください')]];
const image=productImageFor(p.id);
const related=products.filter(v=>v.id!==p.id&&v.availability!=='out_of_stock').slice(0,3);
const hasDestination=catalog.links.some(link=>link.productId===p.id&&resolve(link));
const catalogLink=merchant.id==='hamamatsuya';
const destinationLabel=p.availability==='out_of_stock'?t(locale,'Ask about restocking','再入荷を販売店で確認する'):catalogLink?t(locale,'Explore the maker’s designs',p.productType.includes('necklace')?'工房でペンダントを見る':p.productType.includes('clip-on-earrings')?'工房でイヤリングを見る':'工房でピアスを見る'):t(locale,'See this piece at the retailer','販売店でこの商品を見る');
const destinationNote=catalogLink?t(locale,'Opens the maker’s official catalog. Ask the maker how to order the pair you choose.','工房の公式カタログが開きます。購入方法は工房でご確認ください。'):t(locale,'Opens the official product page. The retailer handles your purchase.','公式商品ページが開きます。購入はリンク先の販売店で行います。');
---
<Base title={p.title} description={p.editorialSummary} locale={locale}>
<div class="wrap product-shopping-page" data-product-page>
 <div class="breadcrumbs purchase-breadcrumbs"><a href={href('objects/')}>{t(locale,'The selection','商品セレクト')}</a><span>/</span><span>{p.title}</span></div>
 <section class="purchase-hero" data-product-intro>
  <header class="purchase-intro"><p class="eyebrow">{labels('crafts',p.craftIds,locale)} / {labels('productTypes',p.productType,locale)}</p><p class="purchase-product-name">{p.title}</p><h1>{story.headline}</h1></header>
  <div class="purchase-visual">{image?<EditorialImage image={image} locale={locale} priority/>:<Pattern variant={index} locale={locale}/>}</div>
  <div class="purchase-buy"><p class="purchase-standfirst">{story.standfirst}</p><div class="purchase-price-row"><p class="purchase-price" data-product-price>{price(p,locale)}</p><span>{t(locale,'Listed price','掲載価格')}</span></div><p class="purchase-price-note">{t(locale,'Checked ','確認：')}{p.priceCheckedAt}{t(locale,' · Check final price and delivery with the seller.','。税・送料・在庫は販売店でご確認ください。')}</p>
   {p.availability==='out_of_stock'&&<p class="purchase-stock-note">{t(locale,'Sold out when checked. Explore the listing or ask the seller about restocking.','確認時点で欠品しています。販売店で再入荷をご確認ください。')}</p>}
   <Disclosure productIds={[p.id,...related.map(v=>v.id)]} locale={locale} compact/>
   <div class="purchase-primary" data-product-primary-cta><RetailerLink productId={p.id} locale={locale} label={destinationLabel}/></div><p class="purchase-destination-note">{destinationNote}</p>
   <ul class="purchase-highlights">{story.highlights.map(highlight=><li>{highlight}</li>)}</ul>
  </div>
 </section>
 <section class="purchase-story" aria-labelledby="why-this-piece"><div><p class="eyebrow">{t(locale,'WHY WE PICKED IT','このひとつを選んだ理由')}</p><h2 id="why-this-piece">{t(locale,'A detail to fall for.','惹かれる、その理由。')}</h2></div><div class="purchase-story-copy">{Content&&<div class="prose"><Content/></div>}</div></section>
 <section class="purchase-outfit" aria-labelledby="outfit-title"><div><p class="eyebrow">{t(locale,'PICTURE YOUR OUTFIT','こんな装いの日に')}</p><h2 id="outfit-title">{story.outfit.title}</h2></div><div><p>{story.outfit.body}</p><p class="purchase-style-note">{t(locale,'A styling idea from our selection, rather than a wear-test review.','装いの提案です。実物の着用レビューではありません。')}</p></div></section>
 <section class="purchase-next"><div><h2>{t(locale,'Found a detail you love?','気になったら、お店で。')}</h2><p>{t(locale,'Explore the maker or retailer’s current designs and find the piece for you.','工房や販売店で、いま選べるデザインを見てみませんか。')}</p></div><div><RetailerLink productId={p.id} locale={locale} label={destinationLabel}/><p class="purchase-destination-note">{destinationNote}</p></div></section>
 <div class="purchase-information">
  <details class="purchase-details" data-product-details><summary>{t(locale,'Materials, size & fittings','素材・サイズ・金具について')}</summary><div class="purchase-details-body"><dl class="spec-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p>{p.taxNote}</p><h2>{t(locale,'Before ordering','注文前に確認すること')}</h2><ul>{p.whatToCheck.map(item=><li>{item}</li>)}</ul>{image&&<p class="muted">{t(locale,'The AI styling image uses a fictional adult model and illustrative jewelry. It does not establish the product’s pattern, dimensions, hardware or fit. Choose using the seller’s actual photographs.','AI着用イメージは架空の成人モデルによる装いの提案で、商品の柄・寸法・金具・着用感を示すものではありません。購入の際は販売店の実物写真をご確認ください。')}</p>}<p class="purchase-price-note">{t(locale,'Product information checked ','商品情報の確認：')}{p.lastVerifiedAt}</p></div></details>
  <details class="purchase-details"><summary>{t(locale,'Delivery & returns','配送・返品について')}</summary><div class="purchase-details-body"><p>{merchant.shipping.summary}</p><h2>{t(locale,'Returns','返品')}</h2><p>{merchant.returns}</p><p>{t(locale,'The retailer handles payment, delivery and order support. Confirm delivery to your country and the total cost before ordering.','決済・発送・注文対応は販売店が行います。配送先への対応と総額は、注文前に販売店でご確認ください。')}</p></div></details>
  <details class="purchase-details"><summary>{t(locale,'Maker, craft & provenance','作り手・工芸・産地について')}</summary><div class="purchase-details-body"><h2><a href={href('makers/'+maker.id+'/')}>{maker.name}</a></h2><p>{maker.productionNote}</p><p>{p.craftClassification.label}</p>{craftNotes.map(note=><p><a href={href('crafts/'+contentSlug(note)+'/')}>{note.data.title} →</a></p>)}</div></details>
  <details class="purchase-details"><summary>{t(locale,'Sources & information checks','出典・情報の確認について')}</summary><div class="purchase-details-body"><Sources sourceIds={sourceIds} locale={locale}/></div></details>
 </div>
 <section class="related purchase-related"><h2>{t(locale,'More pieces to love.','こちらのジュエリーも。')}</h2><div class="product-grid">{related.map((product,i)=><ProductCard product={product} index={i} locale={locale}/>)}</div></section>
 {hasDestination&&<aside class="product-sticky-cta" data-product-sticky-cta hidden aria-label={t(locale,'Selected piece and retailer','選択中の商品と販売店')}><div><span class="sticky-product-name">{p.title}</span><strong>{price(p,locale)}</strong></div><RetailerLink productId={p.id} locale={locale} label={catalogLink?t(locale,'View at maker','工房で見る'):t(locale,'View at retailer','販売店で見る')}/></aside>}
</div>
<script>
 const sticky=document.querySelector<HTMLElement>('[data-product-sticky-cta]');
 const primary=document.querySelector<HTMLElement>('[data-product-primary-cta]');
 const footer=document.querySelector<HTMLElement>('.site-footer');
 if(sticky&&primary){
  let queued=false;
  const update=()=>{sticky.hidden=!matchMedia('(max-width: 720px)').matches||primary.getBoundingClientRect().bottom>=0||!!(footer&&footer.getBoundingClientRect().top<innerHeight)};
  addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(()=>{queued=false;update()})}},{passive:true});
  addEventListener('resize',update);document.addEventListener('toggle',update,true);update();
 }
</script>
</Base>
