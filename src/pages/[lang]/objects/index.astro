---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Disclosure from '../../../components/Disclosure.astro';
import Comparison from '../../../components/Comparison.astro';
import {catalogFor,productsFor} from '../../../lib/catalog';
import {locales,t} from '../../../lib/i18n';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}))}
const {locale}=Astro.props;const catalog=catalogFor(locale),products=productsFor(locale).sort((a,b)=>Number(a.availability==='out_of_stock')-Number(b.availability==='out_of_stock'));
const groups=[{key:'type',name:t(locale,'Type','種類'),items:catalog.productTypes.filter(item=>products.some(p=>p.productType.includes(item.id)))},{key:'prefecture',name:t(locale,'Maker region','工房の関連産地'),items:catalog.prefectures.filter(item=>products.some(p=>p.prefectureIds.includes(item.id)))},{key:'material',name:t(locale,'Material','素材'),items:catalog.materials.filter(item=>products.some(p=>p.materialIds.includes(item.id)))},{key:'craft',name:t(locale,'Craft','技法'),items:catalog.crafts.filter(item=>products.some(p=>p.craftIds.includes(item.id)))}];
---
<Base title={t(locale,'Japanese Earrings, Clip-ons & Necklaces','日本の工芸ピアス・イヤリング・ネックレス')} description={t(locale,'Discover Japanese craft earrings and necklaces in wood, glass and porcelain. Find your favorite by material, shape and craft.','木・ガラス・陶磁器で出会う、日本の工芸ジュエリー。素材や技法から、好きなピアス・イヤリング・ネックレスを見つけてください。')} locale={locale}><div class="wrap page-bottom"><header class="page-heading"><p class="eyebrow">{t(locale,'THE JEWELRY SELECTION','ジュエリーを探す')}</p><h1>{t(locale,'Find your next piece.','日本の工芸から、')}<br/><em>{t(locale,'Selected with care.','自分らしいひとつを。')}</em></h1><p>{t(locale,'Warm wood, sparkling glass or smooth porcelain? Find the color, shape and craft that feels like you.','木のぬくもり、ガラスのきらめき、白磁のつや。素材やかたちから、あなたらしいひとつを探してみませんか。')}</p></header><Disclosure locale={locale}/><form class="filters" id="object-filters" data-locale={locale} aria-label={t(locale,'Filter jewelry','ジュエリーの絞り込み')}>{groups.map(g=><label>{g.name}<select name={g.key} aria-label={g.name}><option value="">{t(locale,'All options','すべて')}</option>{g.items.map(i=><option value={i.id}>{i.name}</option>)}</select></label>)}<button class="reset-button" type="reset">{t(locale,'Clear filters','絞り込みを解除')}</button></form><noscript><p class="notice">{t(locale,'All jewelry is shown. Enable JavaScript to use filters.','すべてのジュエリーを表示しています。絞り込みにはJavaScriptを有効にしてください。')}</p></noscript><div class="results-bar"><p id="result-count" role="status" aria-live="polite">{t(locale,`${products.length} pieces`,`${products.length}点`)}</p><p>{t(locale,'Unknown attributes do not match a selected filter.','未確認の属性は、絞り込み条件に含めません。')}</p></div><div class="product-grid" id="object-results">{products.map((p,i)=><ProductCard product={p} index={i} locale={locale}/>)}</div><div id="empty-state" class="empty-state" hidden><h2>{t(locale,'No jewelry matches this combination.','この条件に合うジュエリーはありません。')}</h2><p>{t(locale,'Try fewer filters, or clear them to explore the full edit.','条件を少なくするか、解除してすべての掲載商品をご覧ください。')}</p><button class="reset-button" type="button" id="empty-reset">{t(locale,'Clear all filters','すべての条件を解除')}</button></div><Comparison locale={locale}/></div></Base>
<script>
const form=document.querySelector<HTMLFormElement>('#object-filters')!;
const selects=Array.from(form.querySelectorAll('select'));
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));
const update=(writeUrl=true)=>{
 const query=new URLSearchParams();selects.forEach(s=>{if(s.value)query.set(s.name,s.value)});
 let count=0;cards.forEach(card=>{const match=selects.every(s=>!s.value||(card.getAttribute('data-'+s.name)||'').split(' ').includes(s.value));card.hidden=!match;if(match)count++});
 document.querySelector('#result-count')!.textContent=form.dataset.locale==='ja'?`${count}点`:`${count} piece${count===1?'':'s'}`;
 (document.querySelector('#empty-state') as HTMLElement).hidden=count!==0;
 if(writeUrl)history.replaceState(null,'',location.pathname+(query.size?'?'+query.toString():'')+location.hash);
};
function readUrl(){const query=new URLSearchParams(location.search);selects.forEach(s=>{const value=query.get(s.name)||'';s.value=Array.from(s.options).some(o=>o.value===value)?value:''});update(false)}
form.addEventListener('change',()=>update());form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>{selects.forEach(s=>s.value='');update()});document.querySelector('#empty-reset')!.addEventListener('click',()=>form.reset());window.addEventListener('popstate',readUrl);readUrl();
</script>
