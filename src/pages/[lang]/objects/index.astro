---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Disclosure from '../../../components/Disclosure.astro';
import Comparison from '../../../components/Comparison.astro';
import RegionSelection from '../../../components/RegionSelection.astro';
import {catalogFor,productsFor} from '../../../lib/catalog';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
import {materialCollections} from '../../../lib/material-collections';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}))}
const {locale}=Astro.props;const catalog=catalogFor(locale),products=productsFor(locale).sort((a,b)=>Number(a.availability==='out_of_stock')-Number(b.availability==='out_of_stock'));
const groups=[{key:'type',name:t(locale,'Type','種類'),items:catalog.productTypes.filter(item=>products.some(p=>p.productType.includes(item.id)))},{key:'prefecture',name:t(locale,'Maker region','工房の関連産地'),items:catalog.prefectures.filter(item=>products.some(p=>p.prefectureIds.includes(item.id)))},{key:'material',name:t(locale,'Material','素材'),items:catalog.materials.filter(item=>products.some(p=>p.materialIds.includes(item.id)))},{key:'craft',name:t(locale,'Craft','技法'),items:catalog.crafts.filter(item=>products.some(p=>p.craftIds.includes(item.id)))}];
groups.push({key:'budget',name:t(locale,'Japan reference price','国内参考価格の予算'),items:[
 {id:'up-to-5000',name:t(locale,'Up to JPY 5,000','5,000円以下')},
 {id:'5000-10000',name:t(locale,'Over JPY 5,000, up to 10,000','5,000円超〜10,000円')},
 {id:'10000-20000',name:t(locale,'Over JPY 10,000, up to 20,000','10,000円超〜20,000円')},
 {id:'20000-40000',name:t(locale,'Over JPY 20,000, up to 40,000','20,000円超〜40,000円')},
 {id:'over-40000',name:t(locale,'Over JPY 40,000','40,000円超')},
 {id:'unconfirmed',name:t(locale,'Price unconfirmed','価格未確認')},
]});
---
<Base title={t(locale,'Japanese Jewelry: Earrings, Clip-ons & More','日本の工芸ピアス・イヤリング・ネックレス')} description={t(locale,'Browse Japanese craft jewellery in glass, silver, tin, porcelain, textile and wood. Compare earrings, clip-ons, rings and necklaces, with Japan prices and official shops.','ガラス・銀・布・木などで出会う、日本の工芸ジュエリー。素材や技法から、好きなピアス・イヤリング・ネックレスを見つけてください。')} locale={locale}><div class="wrap page-bottom"><header class="page-heading"><p class="eyebrow">{t(locale,'THE JEWELRY SELECTION','ジュエリーを探す')}</p><h1>{t(locale,'Japanese earrings & jewelry.','日本の工芸から、')}<br/><em>{t(locale,'Find your kind.','自分らしいひとつを。')}</em></h1><p>{t(locale,'Japanese earrings, ear cuffs, rings and necklaces in glass, porcelain, silver, textile or wood. Compare designs and Japan reference prices, then explore the official shops.','ガラスのきらめき、布の花、銀や七宝のつや。素材やかたちから、あなたらしいひとつを探してみませんか。')}</p><a class="text-link" href="#all-jewelry">{t(locale,'Go to all jewelry and filters','すべての商品・絞り込みへ')} <span aria-hidden="true">↓</span></a></header>
{materialCollections.length>0&&<nav class="material-guide-links" aria-label={t(locale,'Browse by material','素材から探す')}>
  {materialCollections.map(collection=><a class="text-link" href={pagePath(collection.route,locale)}>{collection.copy[locale].label}</a>)}
</nav>}
<RegionSelection locale={locale} showAllLink={false}/>
<section class="all-jewelry-section" id="all-jewelry">
 <div class="section-heading"><h2>{t(locale,'All jewelry. Your choice.','すべての商品から選ぶ。')}</h2></div>
 <Disclosure locale={locale} purchaseMarket="japan"/>
 <form class="filters" id="object-filters" data-locale={locale} aria-label={t(locale,'Filter jewelry','ジュエリーの絞り込み')}>
  {groups.map(g=><label>{g.name}<select name={g.key} aria-label={g.name}><option value="">{t(locale,'All options','すべて')}</option>{g.items.map(i=><option value={i.id}>{i.name}</option>)}</select></label>)}
  <button class="reset-button" type="reset">{t(locale,'Clear filters','絞り込みを解除')}</button>
 </form>
 <div class="sort-row"><p>{t(locale,'Filter by Japan reference price. Check the retailer for current prices and availability.','国内参考価格で予算を絞れます。現在の価格と在庫は取扱店でご確認ください。')}</p><label>{t(locale,'Order','表示順')}<select id="price-sort" name="sort" form="object-filters"><option value="">{t(locale,'Our selection','おすすめ順')}</option><option value="price-asc">{t(locale,'Japan price: low to high','国内参考価格の安い順')}</option><option value="price-desc">{t(locale,'Japan price: high to low','国内参考価格の高い順')}</option></select></label></div>
 <noscript><p class="notice">{t(locale,'All jewelry is shown. Enable JavaScript to use filters and price order.','すべてのジュエリーを表示しています。絞り込みと並べ替えにはJavaScriptを有効にしてください。')}</p></noscript>
 <div class="results-bar"><p id="result-count" role="status" aria-live="polite">{t(locale,`${products.length} pieces`,`${products.length}点`)}</p><p>{t(locale,'Unknown attributes do not match a selected filter. Unconfirmed prices are listed last in either price order.','未確認の属性は条件に含めません。価格順では、価格未確認の商品を最後に表示します。')}</p></div>
 <div class="product-grid" id="object-results">{products.map((p,i)=><ProductCard product={p} index={i} locale={locale}/>)}</div>
 <div id="empty-state" class="empty-state" hidden><h2>{t(locale,'No jewelry matches this combination.','この条件に合うジュエリーはありません。')}</h2><p>{t(locale,'Try fewer filters, or clear them to explore the full edit.','条件を少なくするか、解除してすべての掲載商品をご覧ください。')}</p><button class="reset-button" type="button" id="empty-reset">{t(locale,'Clear all filters','すべての条件を解除')}</button></div>
 <Comparison locale={locale}/>
</section></div></Base>
<script>
import {compareJapanPrices,type PriceSort} from '../../../lib/shopping-filters';
const form=document.querySelector<HTMLFormElement>('#object-filters')!;
const selects=Array.from(form.querySelectorAll('select'));
const sort=document.querySelector<HTMLSelectElement>('#price-sort')!;
const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));
const container=document.querySelector('#object-results')!;
const priceOf=(card:HTMLElement)=>({amount:card.dataset.japanPrice===undefined?null:Number(card.dataset.japanPrice),order:Number(card.dataset.editorialOrder)});
const update=(writeUrl=true)=>{
 let count=0;cards.forEach(card=>{const match=selects.every(s=>!s.value||(card.getAttribute('data-'+s.name)||'').split(' ').includes(s.value));card.hidden=!match;if(match)count++});
 for(const card of [...cards].sort((a,b)=>compareJapanPrices(priceOf(a),priceOf(b),sort.value as PriceSort)))container.append(card);
 document.querySelector('#result-count')!.textContent=form.dataset.locale==='ja'?`${count}点`:`${count} piece${count===1?'':'s'}`;
 (document.querySelector('#empty-state') as HTMLElement).hidden=count!==0;
 if(writeUrl){
  const url=new URL(location.href);
  for(const field of [...selects,sort]){
   if(field.value)url.searchParams.set(field.name,field.value);
   else url.searchParams.delete(field.name);
  }
  history.replaceState(history.state,'',url);
 }
};
function readUrl(){const query=new URLSearchParams(location.search);for(const select of [...selects,sort]){const value=query.get(select.name)||'';select.value=Array.from(select.options).some(option=>option.value===value)?value:''}update(false)}
form.addEventListener('change',()=>update());sort.addEventListener('change',()=>update());form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('reset',()=>{for(const select of [...selects,sort])select.value='';update()});document.querySelector('#empty-reset')!.addEventListener('click',()=>form.reset());window.addEventListener('popstate',readUrl);readUrl();
</script>

<style>
 .material-guide-links{display:flex;flex-wrap:wrap;gap:0 24px;margin-bottom:20px}
 .material-guide-links a{display:inline-flex;align-items:center;min-height:44px}
</style>

<style>.all-jewelry-section{padding-top:65px;scroll-margin-top:24px}.page-heading>.text-link{margin-top:10px}.filters{display:grid;grid-template-columns:repeat(5,minmax(0,1fr)) auto}.filters label{min-width:0}.sort-row{display:flex;justify-content:space-between;align-items:end;gap:22px;margin:20px 0}.sort-row p{max-width:570px;font-size:11px;color:var(--muted);margin:0}.sort-row label{display:grid;gap:6px;font-size:11px;min-width:220px}.sort-row select{background:var(--paper);border:1px solid var(--line);padding:10px;min-height:44px;width:100%}.results-bar>p:last-child{max-width:600px;text-align:right}@media(max-width:1000px){.filters{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:720px){.all-jewelry-section{padding-top:42px}.filters{grid-template-columns:repeat(2,minmax(0,1fr))}.sort-row{display:grid;gap:15px}.sort-row label{min-width:0}.results-bar{align-items:start;gap:15px}.results-bar>p:last-child{max-width:66%}}</style>
