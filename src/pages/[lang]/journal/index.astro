---
import LegacyRedirect from '../../../components/LegacyRedirect.astro';
import {locales} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
export function getStaticPaths(){return locales.map(locale=>({params:{lang:locale},props:{locale}}))}
const {locale}=Astro.props;
---
<LegacyRedirect locale={locale} target={pagePath('objects/',locale)}/>
