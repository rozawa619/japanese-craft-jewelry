---
import LegacyRedirect from '../../../components/LegacyRedirect.astro';
import {locales} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
import {legacyJournalTargets} from '../../../lib/legacy-routes';
export function getStaticPaths(){return locales.flatMap(locale=>Object.entries(legacyJournalTargets).map(([slug,target])=>({params:{lang:locale,slug},props:{locale,target}})))}
const {locale,target}=Astro.props;
---
<LegacyRedirect locale={locale} target={pagePath(target,locale)}/>
