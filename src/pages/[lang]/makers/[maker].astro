---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Sources from '../../../components/Sources.astro';
import Disclosure from '../../../components/Disclosure.astro';
import {catalogFor,productsFor} from '../../../lib/catalog';
import {locales,t} from '../../../lib/i18n';
export function getStaticPaths(){return locales.flatMap(locale=>catalogFor(locale).makers.filter(m=>productsFor(locale).some(p=>p.makerId===m.id)).map(maker=>({params:{lang:locale,maker:maker.id},props:{maker,locale}})))}
const {maker,locale}=Astro.props;const items=productsFor(locale).filter(p=>p.makerId===maker.id);
---
<Base title={maker.name} description={maker.productionNote} locale={locale}><div class="wrap page-bottom"><header class="page-heading"><p class="eyebrow">{t(locale,'MAKERS & PROVENANCE','作り手と来歴')}</p><h1>{maker.name}</h1><p>{maker.productionNote}</p></header><div class="notice"><strong>{t(locale,'Location:','所在地：')}</strong> {maker.location}{t(locale,'.','。')} {maker.id.includes('unidentified')?t(locale,'This is a transparency record for jewelry whose maker is not identified, not a workshop profile.','作り手が特定できていない商品の情報を明示するページです。工房の紹介ではありません。'):t(locale,'Our account is based on official published sources. We have not visited or interviewed the workshop.','公式に公開された資料をもとに紹介しています。工房への訪問や取材は行っていません。')}</div><p><a class="text-link" href={maker.url} target="_blank" rel="noopener noreferrer">{t(locale,'View the official source ↗','公式情報を見る ↗')}</a></p><Disclosure productIds={items.map(p=>p.id)} locale={locale} purchaseMarket="japan"/><div class="product-grid">{items.map((p,i)=><ProductCard product={p} index={i} locale={locale}/>)}</div><div class="related"><Sources sourceIds={maker.sourceIds} locale={locale}/></div></div></Base>
