---
import Base from '../../../layouts/Base.astro';
import {catalogFor,productsFor,byId} from '../../../lib/catalog';
import {contentFor,contentSlug} from '../../../lib/content';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}))}
const {locale}=Astro.props;const catalog=catalogFor(locale),products=productsFor(locale);
const regions=(await contentFor('places',locale)).filter(note=>note.body?.trim()&&products.some(p=>p.prefectureIds.includes(note.data.prefectureId)));
---
<Base title={t(locale,'Craft jewelry across Japan','日本各地の工芸をめぐる')} description={t(locale,'Explore the places and workshop stories behind Japanese craft jewelry. Regional notes are added as makers, pieces and sources are researched.','ジュエリーの背景にある、日本各地の産地と作り手。工房・商品・一次情報を確認できた地域から紹介しています。')} locale={locale}><div class="wrap page-bottom"><header class="page-heading"><p class="eyebrow">{t(locale,'PLACES & PEOPLE · JAPAN','日本の産地と作り手')}</p><h1>{t(locale,'Craft, across Japan.','日本各地の、')}<br/><em>{t(locale,'Every place has a story.','工芸と出会う。')}</em></h1><p>{t(locale,'Discover Japanese jewelry through the places, materials and techniques that shape it. Each regional note starts with the makers and pieces we can trace to primary sources.','その土地の素材や技法が、身につけるひとつになるまで。一次情報でたどれる作り手や商品を入り口に、日本各地の工芸を紹介します。')}</p></header><div class="region-directory">{regions.map((note,i)=>{const region=byId(catalog.prefectures,note.data.prefectureId);const count=products.filter(p=>p.prefectureIds.includes(region.id)).length;return <article class="region-directory-card"><div class="region-directory-mark" aria-hidden="true"><span>{String(i+1).padStart(2,'0')}</span><span>CRAFT / JAPAN</span></div><div><p class="eyebrow">{t(locale,'A RESEARCHED REGIONAL NOTE','調査した産地の記録')}</p><h2><a href={pagePath(`places/${contentSlug(note)}/`,locale)}>{region.name}</a></h2><p>{note.data.description}</p><p class="muted">{t(locale,`${count} jewelry pieces connected to a local workshop. Item-level origin and retailer location remain separate facts.`,`地域の工房に関連するジュエリー${count}点を掲載。工房の所在地・個別商品の製造地・販売店の所在地は区別して案内します。`)}</p><a class="text-link" href={pagePath(`places/${contentSlug(note)}/`,locale)}>{t(locale,'Read the regional story','産地の記事を読む')}<span aria-hidden="true">→</span></a></div></article>})}</div><section class="region-scope"><h2>{t(locale,'One region at a time.','ひとつずつ、確かめながら。')}</h2><p>{t(locale,'The current regional edit begins with Hakone in Kanagawa. Our scope is Japan: new places join when we can offer useful research, clear provenance and jewelry to explore. A regional name alone does not establish how an individual piece was made.','現在の産地記事は神奈川県・箱根から始まっています。対象は日本全国。作り手や商品、根拠を確認できた産地から、内容のある紹介を増やしていきます。土地の名前だけで、個別作品の製造地や認定を決めつけません。')}</p></section></div></Base>
