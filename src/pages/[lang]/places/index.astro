---
import Base from '../../../layouts/Base.astro';
import RegionSelection from '../../../components/RegionSelection.astro';
import {locales,t} from '../../../lib/i18n';
export function getStaticPaths(){return locales.map(lang=>({params:{lang},props:{locale:lang}}))}
const {locale}=Astro.props;
---
<Base title={t(locale,'Japanese jewelry by region','産地から選ぶ、日本の工芸ジュエリー')} description={t(locale,'Explore Japanese craft jewelry by destination. Choose a prefecture, discover its jewelry and find official shops and visiting information.','産地と代表の一品から、日本各地の工芸ジュエリーを選ぶ。都道府県別に商品をまとめ、公式サイトや店舗への行き方も案内します。')} locale={locale}>
 <div class="wrap page-bottom">
  <header class="page-heading"><p class="eyebrow">{t(locale,'JEWELRY BY REGION','産地別の商品セレクト')}</p><h1>{t(locale,'A place in Japan.','旅先で出会う、')}<br/><em>{t(locale,'A piece to remember.','好きなかたち。')}</em></h1><p>{t(locale,'A color, a material, a way of making. Explore jewelry through the places that give it character.','その土地の色、素材、手仕事。気になる産地から、いつもの装いに連れて帰りたいジュエリーを探してください。')}</p></header>
  <RegionSelection locale={locale}/>
 </div>
</Base>
