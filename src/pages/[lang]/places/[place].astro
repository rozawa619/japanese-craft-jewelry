---
import {render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Sources from '../../../components/Sources.astro';
import Disclosure from '../../../components/Disclosure.astro';
import {productsFor,catalogFor,byId} from '../../../lib/catalog';
import {contentFor,contentSlug} from '../../../lib/content';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
export async function getStaticPaths(){const paths=[];for(const locale of locales){for(const note of await contentFor('places',locale)){if(note.body?.trim()&&productsFor(locale).some(p=>p.prefectureIds.includes(note.data.prefectureId)))paths.push({params:{lang:locale,place:contentSlug(note)},props:{note,locale}})}}return paths}
const {note,locale}=Astro.props;const {Content}=await render(note);const catalog=catalogFor(locale),products=productsFor(locale);
const prefecture=byId(catalog.prefectures,note.data.prefectureId);
const local=products.filter(p=>p.prefectureIds.includes(prefecture.id));
const retailer=products.filter(p=>!p.prefectureIds.includes(prefecture.id)&&p.merchantIds.some(id=>note.data.relatedMerchantIds.includes(id)));
---
<Base title={note.data.title} description={note.data.description} locale={locale}><div class="wrap page-bottom"><header class="page-heading"><div class="breadcrumbs"><a href={pagePath('places/',locale)}>{t(locale,'Jewelry by region','産地から選ぶ')}</a><span>/</span><span>{prefecture.name}</span></div><p class="eyebrow">{t(locale,'REGIONAL SELECTION','産地別セレクト')}</p><h1>{note.data.title}</h1><p>{note.data.description}</p></header><div class="section-heading"><h2>{t(locale,'Connected to a local workshop.','地域の工房に関連する商品。')}</h2></div><Disclosure productIds={[...local,...retailer].map(p=>p.id)} locale={locale}/><div class="product-grid">{local.map((p,i)=><ProductCard product={p} index={i} locale={locale}/>)}</div>{retailer.length>0&&<section class="maker-block"><h2>{t(locale,'From a regional retailer.','地域の販売店が扱う商品。')}</h2><p>{t(locale,'The retailer is in this region. The maker and manufacturing location of each piece remain unconfirmed.','この地域の販売店が扱う商品です。個別の作り手と製造地は未確認のため、工房との関連とは区別しています。')}</p><div class="product-grid">{retailer.map((p,i)=><ProductCard product={p} index={i+local.length} locale={locale}/>)}</div></section>}<details class="collection-context"><summary>{t(locale,'About the regional connection','産地との関係について')}</summary><div class="prose"><Content/></div></details><div class="related"><Sources sourceIds={note.data.sourceIds} locale={locale}/></div></div></Base>
