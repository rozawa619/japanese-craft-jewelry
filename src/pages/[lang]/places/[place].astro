---
import {render} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Sources from '../../../components/Sources.astro';
import Disclosure from '../../../components/Disclosure.astro';
import {productsFor,catalogFor,byId} from '../../../lib/catalog';
import {contentFor,contentSlug} from '../../../lib/content';
import {locales,t} from '../../../lib/i18n';
import {pagePath} from '../../../config/site';
export async function getStaticPaths(){const paths=[];for(const locale of locales){for(const note of await contentFor('places',locale)){if(note.body?.trim()&&productsFor(locale).some(p=>p.prefectureIds.includes(note.data.prefectureId)))paths.push({params:{lang:locale,place:contentSlug(note)},props:{note,locale}})}}return paths}
const {note,locale}=Astro.props;const {Content}=await render(note);const catalog=catalogFor(locale),products=productsFor(locale);
const prefecture=byId(catalog.prefectures,note.data.prefectureId);
const local=products.filter(p=>p.prefectureIds.includes(prefecture.id));
const retailer=products.filter(p=>!p.prefectureIds.includes(prefecture.id)&&p.merchantIds.some(id=>note.data.relatedMerchantIds.includes(id)));
---
<Base title={note.data.title} description={note.data.description} locale={locale}><div class="wrap page-bottom"><header class="page-heading"><div class="breadcrumbs"><a href={pagePath('places/',locale)}>{t(locale,'Regions of Japan','日本の産地')}</a><span>/</span><span>{prefecture.name}</span></div><p class="eyebrow">{t(locale,'PLACES & PEOPLE','産地と作り手')} / {prefecture.name}</p><h1>{note.data.title}</h1><p>{note.data.description}</p></header><div class="region-intro"><div class="prose"><Content/></div><aside class="region-facts"><p class="eyebrow">{t(locale,'READING THIS EDIT','この記事で区別していること')}</p><h2>{t(locale,'Three things we keep separate.','3つの所在地を、混同しない。')}</h2><ol><li><strong>{t(locale,'Workshop:','工房：')}</strong> {t(locale,'where a maker is documented to work.','作り手が活動していると確認できる場所。')}</li><li><strong>{t(locale,'Manufacturing:','製造地：')}</strong> {t(locale,'where a specific piece is made.','個別の商品が作られた場所。')}</li><li><strong>{t(locale,'Retail:','販売店：')}</strong> {t(locale,'where it is sold.','商品が販売されている場所。')}</li></ol><p>{t(locale,'Unknown item-level details remain visible on each jewelry page.','未確認の情報は、各商品ページでも明記しています。')}</p></aside></div><div class="section-heading"><h2>{t(locale,`Connected to a ${prefecture.name} workshop.`,prefecture.name+'の工房に関連するジュエリー。')}</h2></div><Disclosure productIds={[...local,...retailer].map(p=>p.id)} locale={locale}/><div class="product-grid">{local.map((p,i)=><ProductCard product={p} index={i} locale={locale}/>)}</div>{retailer.length>0&&<section class="maker-block"><h2>{t(locale,'Also sold by a regional retailer.','地域の販売店が扱うジュエリー。')}</h2><p>{t(locale,'These listings connect to a retailer in this region. Their individual maker and manufacturing location remain unconfirmed.','この地域の販売店が扱う商品です。個別の作り手と製造地は、確認した資料では特定できていません。')}</p><div class="product-grid">{retailer.map((p,i)=><ProductCard product={p} index={i+2} locale={locale}/>)}</div></section>}<Sources sourceIds={note.data.sourceIds} locale={locale}/></div></Base>
