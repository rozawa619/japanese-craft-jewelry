---
import {pagePath} from '../config/site';
const {guide,index=0}=Astro.props;
---
<a class="guide-card" href={pagePath(`journal/${guide.id}/`)}>
 <div class="guide-card-top"><span class="eyebrow">{guide.data.category}</span><span class="guide-index">0{index+1}</span></div>
 <h3>{guide.data.title}</h3><p>{guide.data.description}</p><span class="text-link">{guide.data.readMinutes} min read <span aria-hidden="true">↗</span></span>
</a>