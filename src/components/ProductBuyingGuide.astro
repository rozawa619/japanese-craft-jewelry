---
import type {Product} from '../lib/schema';
import {t,type Locale} from '../lib/i18n';
import {buyingGuideFor} from '../lib/product-buying-guides';
interface Props {product:Product;locale:Locale}
const {product,locale}=Astro.props;
const guide=buyingGuideFor(product,locale);
---
<section class="buying-guide" aria-labelledby="choosing-details" data-product-buying-guide={product.id}>
 <div class="buying-guide-heading"><p class="eyebrow">{t(locale,'MAKE IT YOUR CHOICE','自分に合うひとつへ')}</p><h2 id="choosing-details">{t(locale,'A closer look before you choose.','迷ったときの、選び方。')}</h2></div>
 <div class="buying-guide-questions">{guide.questions.map((entry,index)=><article data-buying-question><span class="buying-guide-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><h3>{entry.question}</h3><p>{entry.answer}</p></article>)}</div>
 <a class="buying-guide-sources" href="#product-sources">{t(locale,'Official information behind these details','根拠となる公式情報・出典を見る')} <span aria-hidden="true">↓</span></a>
</section>
<style>
 .buying-guide{padding:48px 0;border-top:1px solid var(--line)}
 .buying-guide-heading{margin-bottom:28px}.buying-guide h2{font-size:clamp(25px,3vw,38px);margin:7px 0 0}
 .buying-guide-questions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
 article{position:relative;border-top:1px solid var(--line);padding-top:18px;min-width:0}.buying-guide-number{font-size:10px;color:var(--muted);letter-spacing:.08em}
 h3{font-size:17px;font-weight:500;line-height:1.65;margin:10px 0 13px;text-wrap:pretty}p{font-size:13px;line-height:1.95;margin:0;overflow-wrap:break-word}
 .buying-guide-sources{display:inline-flex;gap:24px;align-items:center;font-size:11px;line-height:1.7;min-height:44px;margin-top:22px;text-underline-offset:5px}
 @media(max-width:850px){.buying-guide-questions{grid-template-columns:1fr;gap:22px}.buying-guide{padding:34px 0}h3{font-size:17px;margin-top:6px}p{font-size:13px}.buying-guide-heading{margin-bottom:22px}}
</style>
