---
import type {EditorialImage} from '../lib/editorial-images';
import {t,type Locale} from '../lib/i18n';
import{path}from'../config/site';
import ProductImageNote from './ProductImageNote.astro';
interface Props{image:EditorialImage;locale:Locale;officialUrl?:string}
const{image,locale,officialUrl}=Astro.props;
---
<div class="product-detail-art">
 <figure data-product-detail-asset={image.assetId}>
  <img src={path(image.path)} width={image.width} height={image.height} alt={image.alt[locale]} loading="lazy" decoding="async"/>
  <figcaption>{t(locale,'AI image','AIイメージ')}</figcaption>
 </figure>
 {officialUrl&&<ProductImageNote locale={locale} variant="compact"/>}
 {officialUrl&&<a href={officialUrl} target="_blank" rel="noopener noreferrer" class="product-detail-photo-link" data-detail-official-photo>{t(locale,'See the actual piece on the official page','実物を公式ページで見る')} <span aria-hidden="true">↗</span><span class="sr-only">{t(locale,' (opens in a new tab)','（新しいタブで開く）')}</span></a>}
</div>
<style>
 .product-detail-art{width:100%;max-width:290px;justify-self:end;min-width:0}figure{margin:0;background:#f2efe8;border:1px solid var(--line)}img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain}figcaption{font-size:10px;line-height:1.6;padding:9px 12px;border-top:1px solid var(--line);color:var(--muted)}.product-detail-photo-link{display:flex;justify-content:space-between;gap:12px;align-items:center;min-height:44px;font-size:11px;line-height:1.7;text-decoration:none;border-bottom:1px solid var(--line);padding:8px 0}
 @media(max-width:1100px){.product-detail-art{max-width:260px;justify-self:start}}@media(max-width:720px){.product-detail-art{max-width:320px;justify-self:center}}
</style>
