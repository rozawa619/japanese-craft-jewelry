---
import geometry from '../data/japan-map-geometry.json';
import {japanMapAreas} from '../config/japan-map';
import {catalogFor,labels,productsFor} from '../lib/catalog';
import {contentFor,contentSlug} from '../lib/content';
import {productDetailImageFor} from '../lib/product-detail-images';
import {regionalRepresentatives} from '../config/region-selection';
import {marketPricesFor,formatMarketPrice} from '../lib/market-prices';
import {serializeJsonLd} from '../lib/structured-data';
import {pagePath,path} from '../config/site';
import {t,type Locale} from '../lib/i18n';
interface Props{locale:Locale;id:string}
const {locale,id}=Astro.props;
const notes=(await contentFor('places',locale)).filter(note=>note.body?.trim());
const catalog=catalogFor(locale),products=productsFor(locale);
const regions=geometry.prefectures.flatMap(prefecture=>{
 const items=products.filter(product=>product.prefectureIds.includes(prefecture.id));
 const region=catalog.prefectures.find(item=>item.id===prefecture.id);
 const note=notes.find(item=>item.data.prefectureId===prefecture.id);
 if(!items.length||!region||!note)return [];
 const configured=regionalRepresentatives[region.id];
 const representative=items.find(item=>item.id===configured)||items[0];
 const image=productDetailImageFor(representative.id);
 const japan=marketPricesFor(representative.id).japan;
 return [{id:region.id,name:region.name,url:pagePath(`places/${contentSlug(note)}/`,locale),count:items.length,countLabel:t(locale,`${items.length} ${items.length===1?'piece':'pieces'}`,`${items.length}点のジュエリー`),crafts:labels('crafts',[...new Set(items.flatMap(item=>item.craftIds))],locale),productId:representative.id,title:representative.title,productUrl:pagePath(`objects/${representative.slug}/`,locale),image:{src:path(image.path),alt:image.alt[locale],width:image.width,height:image.height},price:formatMarketPrice(japan,locale)}];
});
const available=new Map(regions.map(region=>[region.id,region]));
const first=available.get('tokyo')||regions[0];
if(!first)throw new Error('Japan map requires a published destination');
const areas=japanMapAreas.flatMap(area=>{const items=area.prefectures.flatMap(prefecture=>{const region=available.get(prefecture);return region?[region]:[]});return items.length?[{...area,items}]:[]});
const uid=id+'-japan-map';
const okinawa=geometry.prefectures.find(prefecture=>prefecture.id==='okinawa');
if(!okinawa)throw new Error('Japan map requires the original Okinawa geometry');
const okinawaRegion=available.get(okinawa.id);
// Keep every original CC0 path. Independent viewports remove the long
// southwest gap, while the labelled Okinawa inset remains a native link.
const mainlandViewBox='89 -8 356 400',okinawaViewBox='-6 415 138 108';
const okinawaInsetLabel=t(locale,'Okinawa · enlarged','沖縄（拡大）');
---
<section class="jewelry-map" id={uid} data-japan-map aria-labelledby={uid+'-heading'} tabindex="-1">
 <header class="map-heading"><p class="eyebrow">{t(locale,'FIND YOUR PLACE ON THE MAP','地図で見つける、旅先のひとつ')}</p><h3 id={uid+'-heading'}>{t(locale,'Where in Japan are you going?','日本の「ここ」へ行くなら。')}</h3><p>{t(locale,'Click a highlighted prefecture to explore its jewelry. Okinawa is enlarged in the separate inset. Zoom in for smaller areas.','色の付いた県から、その産地の商品へ。沖縄は別枠で拡大しています。小さな県は地図を拡大して選べます。')}</p></header>
 <div class="map-layout">
  <div class="map-geography">
   <div class="map-legend"><span><i class="map-legend-available"></i>{t(locale,'Jewelry to explore','掲載商品がある産地')}</span><span><i></i>{t(locale,'Not featured yet','未掲載の産地')}</span></div>
   <div class="map-zoom-controls" data-map-zoom-controls hidden aria-label={t(locale,'Map zoom','日本地図の拡大・縮小')}><button type="button" data-map-zoom-out aria-controls={uid+'-viewport'} aria-label={t(locale,'Zoom out','地図を縮小')}>−</button><output data-map-zoom-status aria-live="polite">100%</output><button type="button" data-map-zoom-in aria-controls={uid+'-viewport'} aria-label={t(locale,'Zoom in','地図を拡大')}>＋</button><button type="button" data-map-zoom-reset aria-controls={uid+'-viewport'}>{t(locale,'Fit Japan','全体表示')}</button><span>{t(locale,'Scroll to move around when zoomed in.','拡大後は地図の中をスクロールできます。')}</span></div>
   <div class="map-stage" data-map-stage>
   <div class="map-viewport" id={uid+'-viewport'} data-map-viewport data-map-zoom="1" tabindex="0" role="region" aria-label={t(locale,'Japan map. Scroll to move around when zoomed in. Okinawa is in the separate enlarged inset.','日本地図。拡大時は上下左右にスクロールできます。沖縄は別枠の拡大図です。')}><div class="map-drawing" data-map-drawing><svg viewBox={mainlandViewBox} class="map-svg" role="group" aria-label={t(locale,'Japan’s prefectures, with Okinawa enlarged separately. Highlighted destinations have published jewelry.','沖縄を別枠で拡大した日本の都道府県地図。色の付いた産地でジュエリーを紹介しています。')} data-japan-map-svg>
    {geometry.prefectures.filter(prefecture=>prefecture.id!==okinawa.id).map(prefecture=>{
     const region=available.get(prefecture.id);
     return region?<a href={region.url} data-map-choice={region.id} data-map-code={prefecture.code} aria-label={t(locale,`Explore jewelry from ${region.name}, ${region.countLabel}`,`${region.name}の商品を見る、${region.countLabel}`)} aria-current={region.id===first.id?'true':undefined}><title>{region.name}</title><path d={prefecture.d} data-map-shape={prefecture.id}/></a>:<path d={prefecture.d} class="map-unlisted" data-map-unlisted={prefecture.id} data-map-shape={prefecture.id}><title>{prefecture.name[locale]} — {t(locale,'not featured yet','未掲載')}</title></path>;
    })}
   </svg></div></div>
   {okinawaRegion?<a class="map-okinawa-inset" href={okinawaRegion.url} data-map-choice={okinawa.id} data-map-code={okinawa.code} data-map-okinawa-inset aria-label={okinawaInsetLabel+' — '+t(locale,`Explore jewelry from ${okinawaRegion.name}`,`${okinawaRegion.name}の商品を見る`)} aria-current={okinawa.id===first.id?'true':undefined}>
    <span class="map-okinawa-label">{okinawaInsetLabel}<span aria-hidden="true">↗</span></span>
    <svg viewBox={okinawaViewBox} aria-hidden="true" focusable="false" data-map-okinawa-svg><path d={okinawa.d} data-map-shape={okinawa.id}/></svg>
   </a>:<div class="map-okinawa-inset map-okinawa-unlisted" data-map-okinawa-inset><span class="map-okinawa-label">{okinawaInsetLabel}</span><svg viewBox={okinawaViewBox} role="img" aria-label={t(locale,'Okinawa — not featured yet','沖縄県 — 未掲載')} data-map-okinawa-svg><path d={okinawa.d} data-map-unlisted={okinawa.id} data-map-shape={okinawa.id}/></svg></div>}
   </div>
   <p class="map-overview-note">{t(locale,'An overview for finding destinations, not a navigation map.','旅先を探すための略図です。')}</p>
  </div>
  <div class="map-selection-column">
   <div class="map-select-field" data-map-select-field hidden><label for={uid+'-select'}>{t(locale,'Choose your destination','行き先から選ぶ')}</label><select id={uid+'-select'} data-map-select>{areas.map(area=><optgroup label={area.name[locale]}>{area.items.map(region=><option value={region.id} selected={region.id===first.id}>{region.name} · {region.countLabel}</option>)}</optgroup>)}</select></div>
   <article class="map-preview" id={uid+'-preview'} data-map-preview data-map-selected={first.id}>
    <div class="map-preview-meta" aria-live="polite" aria-atomic="true"><p class="eyebrow" data-map-count>{first.countLabel}</p><h4 data-map-name>{first.name}</h4><p class="map-preview-crafts" data-map-crafts>{first.crafts}</p></div>
    <a class="map-preview-image" href={first.productUrl} data-map-product-link aria-label={t(locale,`View ${first.title} — AI image`,`${first.title}を見る — AIイメージ`)}><figure><img src={first.image.src} alt={first.image.alt} width={first.image.width} height={first.image.height} loading="lazy" decoding="async" data-map-image/><figcaption>{t(locale,'AI image','AIイメージ')}</figcaption></figure></a>
    <p class="map-preview-title"><a href={first.productUrl} data-map-product-title>{first.title}</a></p><p class="map-preview-price"><span data-map-price>{first.price}</span><small>{t(locale,'Japan online reference price','日本向け通販参考価格')}</small></p>
    <a class="map-destination-link" href={first.url} data-map-destination>{t(locale,`Explore ${first.name}`,`${first.name}の商品を見る`)}<span aria-hidden="true">→</span></a>
   </article>
  </div>
 </div>
 <details class="map-destination-list"><summary>{t(locale,`All ${regions.length} destinations, by area`,`${regions.length}の掲載産地を、地方別に見る`)}</summary><div class="map-area-list">{areas.map(area=><section><h4>{area.name[locale]}</h4><ul>{area.items.map(region=><li><a href={region.url} data-map-region-link={region.id}><span>{region.name}</span><small>{region.countLabel}</small><span aria-hidden="true">↗</span></a></li>)}</ul></section>)}</div></details>
 <script type="application/json" data-map-data set:html={serializeJsonLd({regions,locale,viewLabel:t(locale,'View the piece — AI image','商品を見る — AIイメージ'),exploreBefore:t(locale,'Explore ',''),exploreAfter:t(locale,'','の商品を見る')})}/>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-japan-map]').forEach(root=>{
  const dataElement=root.querySelector<HTMLScriptElement>('[data-map-data]');
  if(!dataElement)return;
  type Destination={id:string;name:string;url:string;countLabel:string;crafts:string;productId:string;title:string;productUrl:string;image:{src:string;alt:string;width:number;height:number};price:string};
  let data:{regions:Destination[];viewLabel:string;exploreBefore:string;exploreAfter:string};
  try{data=JSON.parse(dataElement.textContent||'')}catch{return}
  const regions=new Map(data.regions.map(region=>[region.id,region]));
  const preview=root.querySelector<HTMLElement>('[data-map-preview]');
  const select=root.querySelector<HTMLSelectElement>('[data-map-select]');
  const image=root.querySelector<HTMLImageElement>('[data-map-image]');
  const destination=root.querySelector<HTMLAnchorElement>('[data-map-destination]');
  const productLink=root.querySelector<HTMLAnchorElement>('[data-map-product-link]');
  const productTitle=root.querySelector<HTMLAnchorElement>('[data-map-product-title]');
  if(!preview||!select||!image||!destination||!productLink||!productTitle)return;
  function choose(id:string){
   const region=regions.get(id);if(!region||!preview||!select||!image||!destination||!productLink||!productTitle)return;
   if(preview.dataset.mapSelected===id)return;
   preview.dataset.mapSelected=id;select.value=id;
   for(const [selector,text] of [['[data-map-name]',region.name],['[data-map-count]',region.countLabel],['[data-map-crafts]',region.crafts],['[data-map-price]',region.price]]){const node=root.querySelector(selector);if(node)node.textContent=text;}
   image.src=region.image.src;image.alt=region.image.alt;image.width=region.image.width;image.height=region.image.height;
   productLink.href=region.productUrl;productLink.setAttribute('aria-label',region.title+' — '+data.viewLabel);
   productTitle.href=region.productUrl;productTitle.textContent=region.title;
   destination.href=region.url;destination.replaceChildren(document.createTextNode(data.exploreBefore+region.name+data.exploreAfter));
   const arrow=document.createElement('span');arrow.setAttribute('aria-hidden','true');arrow.textContent='→';destination.append(arrow);
   root.querySelectorAll<MapChoice>('[data-map-choice]').forEach(control=>{if(control.dataset.mapChoice===id)control.setAttribute('aria-current','true');else control.removeAttribute('aria-current')});
  }
  root.querySelector<HTMLElement>('[data-map-select-field]')?.removeAttribute('hidden');
  root.dataset.mapEnhanced='true';
  // The mainland uses SVG anchors; Okinawa's entire inset is an HTML anchor.
  type MapChoice=SVGAElement|HTMLAnchorElement;
  root.querySelectorAll<MapChoice>('[data-map-choice]').forEach(control=>{
   const id=control.dataset.mapChoice;if(!id)return;
   control.addEventListener('pointerenter',event=>{if(!('pointerType' in event)||event.pointerType!=='touch')choose(id)});
   control.addEventListener('focus',()=>choose(id));
   // Keep the real href: one click/tap/Enter opens the selected region.
  });
  select.addEventListener('change',()=>choose(select.value));
  const viewport=root.querySelector<HTMLElement>('[data-map-viewport]');
  const drawing=root.querySelector<HTMLElement>('[data-map-drawing]');
  const controls=root.querySelector<HTMLElement>('[data-map-zoom-controls]');
  const zoomIn=root.querySelector<HTMLButtonElement>('[data-map-zoom-in]');
  const zoomOut=root.querySelector<HTMLButtonElement>('[data-map-zoom-out]');
  const reset=root.querySelector<HTMLButtonElement>('[data-map-zoom-reset]');
  const zoomStatus=root.querySelector<HTMLOutputElement>('[data-map-zoom-status]');
  if(viewport&&drawing&&controls&&zoomIn&&zoomOut&&reset&&zoomStatus){
   const scales=[1,1.5,2,3];let index=0;
   function zoom(next:number){
    if(!viewport||!drawing||!zoomIn||!zoomOut||!zoomStatus)return;
    const previous=scales[index],centerX=(viewport.scrollLeft+viewport.clientWidth/2)/previous,centerY=(viewport.scrollTop+viewport.clientHeight/2)/previous;
    index=Math.max(0,Math.min(scales.length-1,next));const scale=scales[index];
    drawing.style.width=String(scale*100)+'%';drawing.style.height=String(scale*100)+'%';viewport.dataset.mapZoom=String(scale);
    viewport.scrollTo({left:index?centerX*scale-viewport.clientWidth/2:0,top:index?centerY*scale-viewport.clientHeight/2:0,behavior:'instant'});
    zoomIn.disabled=index===scales.length-1;zoomOut.disabled=index===0;zoomStatus.textContent=String(scale*100)+'%';
   }
   zoomIn.addEventListener('click',()=>zoom(index+1));zoomOut.addEventListener('click',()=>zoom(index-1));reset.addEventListener('click',()=>zoom(0));controls.hidden=false;zoom(0);
  }
 });
</script>
<style>
 .jewelry-map{max-width:1040px;margin:40px auto;padding:24px;border:1px solid var(--line);background:#eeeee5;scroll-margin-top:28px}
 .map-heading h3{font-size:clamp(25px,2.7vw,34px);line-height:1.4;margin:8px 0 10px;text-wrap:balance}
 .map-heading>p:last-child{max-width:780px;font-size:13px;line-height:1.8;margin:0;color:var(--muted)}
 .map-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(240px,.85fr);gap:28px;align-items:start;max-width:900px;margin:18px auto 0}
 .map-geography,.map-selection-column{min-width:0}.map-geography{width:100%;max-width:480px;justify-self:center}.map-selection-column{width:100%;max-width:330px;justify-self:center}
 .map-legend{display:flex;gap:15px;flex-wrap:wrap;font-size:11px;line-height:1.8;justify-content:center;color:var(--muted)}
 .map-legend span{display:inline-flex;align-items:center;gap:7px}.map-legend i{display:inline-block;width:11px;height:11px;background:#dcdcd3;border:1px solid #c2c5bb}.map-legend i.map-legend-available{background:#637d72;border-color:#637d72}
 .map-stage{position:relative}.map-viewport{width:100%;aspect-ratio:356/400;max-height:540px;overflow:auto;overscroll-behavior:contain;scroll-behavior:auto;touch-action:pan-x pan-y pinch-zoom;border:1px solid transparent}.map-viewport:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.map-drawing{width:100%;height:100%}.map-svg{display:block;width:100%;height:100%;max-width:none;margin:0;overflow:visible}.map-zoom-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:10px 0}.map-zoom-controls button{min-width:44px;min-height:44px;padding:8px 12px;font:inherit;font-size:14px;background:var(--paper);color:var(--forest);border:1px solid var(--line);cursor:pointer}.map-zoom-controls button:disabled{opacity:.45;cursor:default}.map-zoom-controls button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.map-zoom-controls output{min-width:44px;text-align:center;font-size:12px}.map-zoom-controls>span{font-size:11px;color:var(--muted);line-height:1.7}
 .map-svg path{stroke:#eeeee5;stroke-width:.75;stroke-linejoin:round;vector-effect:non-scaling-stroke}.map-svg a{fill:#637d72;cursor:pointer;outline:none}.map-svg a:hover,.map-svg a:focus-visible,.map-svg a[aria-current=true]{fill:#a86042;stroke:var(--ink)}.map-svg a:focus-visible path{stroke:var(--ink);stroke-width:2}.map-svg .map-unlisted{fill:#dcdcd3}
 .map-okinawa-inset{position:absolute;inset:14px auto auto 0;display:block;width:clamp(80px,30%,144px);min-width:44px;min-height:44px;padding:7px;border:1px dashed var(--muted);background:#eeeee5;color:var(--forest);text-decoration:none}.map-okinawa-label{display:flex;align-items:center;justify-content:space-between;gap:3px;font-size:11px;line-height:1.4}.map-okinawa-label>span{font-size:12px}.map-okinawa-inset svg{display:block;width:100%;height:auto;aspect-ratio:138/108;margin-top:4px;fill:#637d72}.map-okinawa-inset path{stroke:#eeeee5;stroke-width:.35;stroke-linejoin:round;vector-effect:non-scaling-stroke}.map-okinawa-inset:hover,.map-okinawa-inset[aria-current=true]{border-style:solid;border-color:var(--accent);color:var(--accent)}.map-okinawa-inset:hover svg,.map-okinawa-inset[aria-current=true] svg{fill:#a86042}.map-okinawa-inset:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.map-okinawa-unlisted{color:var(--muted)}.map-okinawa-unlisted svg{fill:#dcdcd3}
 .map-overview-note{font-size:10px;line-height:1.7;text-align:center;color:var(--muted);margin:4px 0 0}
 .map-select-field{margin-bottom:12px}.map-select-field label{display:block;font-size:11px;margin-bottom:6px}.map-select-field select{display:block;width:100%;min-height:46px;min-width:0;border:1px solid var(--muted);border-radius:0;background:var(--paper);color:var(--ink);font:16px/1.5 var(--sans);padding:9px 32px 9px 11px}
 .map-preview{background:var(--paper);border:1px solid var(--line);padding:16px;min-width:0;scroll-margin-block:24px}.map-preview-meta .eyebrow{font-size:10px;color:var(--muted);margin:0 0 6px}.map-preview h4{font:400 clamp(26px,2.6vw,33px)/1.35 var(--serif);margin:0 0 8px;overflow-wrap:anywhere}.map-preview-crafts{font-size:11px;line-height:1.8;color:var(--accent);margin:0 0 12px}
 .map-preview-image{display:block;text-decoration:none}.map-preview figure{margin:0;border:1px solid var(--line);background:#f2efe8}.map-preview img{display:block;width:100%;height:auto;aspect-ratio:1.25;object-fit:contain}.map-preview figcaption{font-size:10px;line-height:1.6;text-align:center;color:var(--muted);padding:5px;border-top:1px solid var(--line)}
 .map-preview-title{font:16px/1.55 var(--serif);margin:12px 0 7px;overflow-wrap:anywhere}.map-preview-title a{text-decoration:none;display:flex;min-height:44px;align-items:center}.map-preview-title a:hover{text-decoration:underline}.map-preview-price{font-size:13px;line-height:1.7;margin:0 0 12px}.map-preview-price small{display:block;font-size:10px;color:var(--muted);margin-top:3px}
 .map-destination-link{display:flex;justify-content:space-between;align-items:center;gap:15px;text-decoration:none;background:var(--forest);color:var(--paper);font-size:12px;line-height:1.7;min-height:48px;padding:11px 15px}.map-destination-link:hover{background:#354a41}
 .map-destination-list{margin-top:20px;border-top:1px solid var(--line);padding-top:6px}.map-destination-list summary{cursor:pointer;min-height:46px;align-content:center;font-size:12px;padding:10px 0;line-height:1.8}.map-area-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:16px}.map-area-list h4{font:16px/1.6 var(--serif);margin:0 0 10px}.map-area-list ul{list-style:none;padding:0;margin:0}.map-area-list li+li{border-top:1px solid var(--line)}.map-area-list a{display:flex;align-items:center;gap:8px;min-height:46px;font-size:12px;line-height:1.6;text-decoration:none;padding:8px 0}.map-area-list a:hover{text-decoration:underline}.map-area-list a>span:first-child{flex:1}.map-area-list small{font-size:10px;color:var(--muted)}
 .map-preview a:focus-visible,.map-destination-list a:focus-visible,.map-destination-list summary:focus-visible,.map-select-field select:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
 @media(max-width:900px){.jewelry-map{padding:22px}.map-layout{gap:22px;grid-template-columns:minmax(0,1.2fr) minmax(220px,.85fr)}.map-preview{padding:15px}.map-preview h4{font-size:29px}.map-area-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:740px){.jewelry-map{margin-block:30px;padding:18px 16px}.map-heading h3{font-size:25px}.map-heading>p:last-child{font-size:12px}.map-layout{grid-template-columns:1fr;gap:18px;margin-top:18px}.map-geography{max-width:480px}.map-selection-column{display:grid;gap:0;max-width:480px}.map-legend{font-size:10px;gap:11px}.map-select-field{margin-bottom:12px}.map-preview{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);column-gap:16px;padding:15px}.map-preview-meta{grid-column:1/-1}.map-preview h4{font-size:28px;margin-bottom:6px}.map-preview-crafts{margin-bottom:12px}.map-preview-image{grid-column:1;grid-row:2/4;align-self:start}.map-preview img{aspect-ratio:1}.map-preview-title{grid-column:2;margin:0 0 7px;font-size:15px}.map-preview-price{grid-column:2;font-size:12px;align-self:start;margin-bottom:12px}.map-destination-link{grid-column:1/-1;margin-top:13px;font-size:12px}.map-area-list{column-gap:18px;row-gap:20px}.map-area-list h4{font-size:15px}.map-area-list a{font-size:11px;flex-wrap:wrap}.map-area-list small{font-size:9px}.map-destination-list{margin-top:18px}.map-okinawa-inset{inset-block-start:8px;padding:5px}.map-okinawa-label{display:block;font-size:9px;line-height:1.4}.map-okinawa-label>span{display:none}}
 @media(max-width:360px){.jewelry-map{padding-inline:12px}.map-heading h3{font-size:24px}.map-preview{padding:13px;column-gap:12px}.map-preview-title{font-size:14px}.map-area-list{grid-template-columns:1fr}.map-zoom-controls{gap:6px}.map-zoom-controls>span{width:100%}}
</style>
