---
import {productsFor,labels,price,catalogFor} from '../lib/catalog';
import {pagePath} from '../config/site';
import {t,type Locale} from '../lib/i18n';
interface Props {productIds?:string[];locale?:Locale}
const {locale='en'}=Astro.props;
const products=productsFor(locale);
const catalog=catalogFor(locale);
const {productIds=products.filter(p=>p.productType.some(type=>type.includes('earrings'))).map(p=>p.id)}=Astro.props;
const items=products.filter(p=>productIds.includes(p.id));
---
<section class="comparison-section" aria-labelledby="compare-heading"><div class="section-heading"><h2 id="compare-heading">{t(locale,'The details, side by side.','仕様を並べて比べる。')}</h2><span class="eyebrow">{t(locale,'Published facts, not a ranking','確認できた情報の比較・順位付けではありません')}</span></div>
<p class="muted">{t(locale,'Prices use the original listed currency, with the date checked. Measurements come from the official information.','価格は公式ページの表示通貨で、確認日とともに掲載しています。サイズは公式情報をもとにまとめています。')}</p>
<div class="table-scroll" tabindex="0" role="region" aria-label={t(locale,'Jewelry comparison, scroll horizontally on small screens','ジュエリーの比較表。小さい画面では横にスクロールできます。')}><table><caption class="sr-only">{t(locale,'Verified jewelry details','確認できたジュエリーの仕様')}</caption><thead><tr><th scope="col">{t(locale,'Jewelry','ジュエリー')}</th><th scope="col">{t(locale,'Type','種類')}</th><th scope="col">{t(locale,'Size / weight','寸法・重量')}</th><th scope="col">{t(locale,'Materials','素材')}</th><th scope="col">{t(locale,'Listed price','掲載価格')}</th><th scope="col">{t(locale,'Overseas buying','海外からの購入')}</th></tr></thead><tbody>{items.map(p=><tr><th scope="row"><a href={pagePath(`objects/${p.slug}/`,locale)}>{p.title}</a></th><td>{labels('productTypes',p.productType,locale)}</td><td>{p.size||t(locale,'Size unconfirmed','寸法は未確認')}<br/>{p.weightPerPieceGrams===null?t(locale,'Weight unconfirmed','重量は未確認'):t(locale,`${p.weightPerPieceGrams} g per piece`,`1点あたり${p.weightPerPieceGrams} g`)}</td><td>{labels('materials',p.materialIds,locale)}<br/>{p.findings||t(locale,'Hardware unconfirmed','金具の仕様は未確認')}</td><td>{price(p,locale)}<small>{t(locale,`Checked ${p.priceCheckedAt}`,`${p.priceCheckedAt}確認`)}</small><small>{p.taxNote}</small>{p.availability==='out_of_stock'&&<small>{t(locale,'Sold out when checked','確認時点で欠品')}</small>}</td><td>{catalog.merchants.find(m=>m.id===p.merchantIds[0])?.shipping.summary}</td></tr>)}</tbody></table></div></section>
