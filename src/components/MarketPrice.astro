---
import {marketPricesFor,formatMarketPrice,type PriceMarket} from '../lib/market-prices';
import {purchaseEvidenceFor} from '../lib/purchase-evidence';
import {t,type Locale} from '../lib/i18n';
interface Props {productId:string;locale:Locale;market?:PriceMarket;variant?:'compact'|'detail'|'sticky';primary?:boolean;}
const {productId,locale,market='japan',variant='compact',primary=false}=Astro.props;
const value=marketPricesFor(productId)[market];
const onlinePrice=market==='japan'&&value&&purchaseEvidenceFor(productId).kind==='online-order';
const label=market==='international'?t(locale,'International store reference','海外通販の参考価格')
 :onlinePrice?t(locale,'Japan online reference','日本向け通販の参考価格')
 :t(locale,'Japan reference price','国内参考価格');
---
<span class:list={['market-price',`market-price-${variant}`]} data-market-price-block={market} data-price-product={productId}>
 <span class="market-price-label">{label}</span>
 <span class="market-price-amount" data-product-price={primary||undefined} data-price-market={market} data-price-amount={value?.amount} data-price-currency={value?.currency} data-price-checked-at={value?.checkedAt||undefined}>{formatMarketPrice(value,locale)}</span>
 {value?.unit&&<span class="market-price-unit" data-price-unit={value.unit}>{value.unit==='single-ear'?t(locale,'Single earring · one ear','片耳用・1点の価格'):value.unit==='pair'?t(locale,'Pair price','1組の価格'):t(locale,'One-item price','1点の価格')}</span>}
</span>
<style>
 .market-price{display:grid;gap:3px;white-space:normal;min-width:0;line-height:1.5}
 .market-price .market-price-label{display:block;font:10px/1.5 var(--sans);color:var(--muted);letter-spacing:0;white-space:normal}
 .market-price .market-price-amount{display:block;font:14px/1.35 var(--sans);color:var(--ink);letter-spacing:0;white-space:normal}
 .market-price-unit{font:10px/1.5 var(--sans);color:var(--muted)}.market-price-sticky .market-price-unit{font-size:10px}
 .market-price-detail{gap:5px}
 .market-price-detail .market-price-label{font-size:11px}
 .market-price-detail .market-price-amount{font:32px/1.2 var(--serif)}
 .market-price-sticky{gap:1px}
 .market-price-sticky .market-price-label{font-size:10px}
 .market-price-sticky .market-price-amount{font:18px/1.2 var(--serif)}
 @media(max-width:720px){.market-price-detail .market-price-amount{font-size:29px}.market-price .market-price-label{font-size:11px}.market-price .market-price-amount{font-size:13px}.market-price-detail .market-price-amount{font-size:29px}.market-price-sticky .market-price-amount{font-size:18px}.market-price-sticky .market-price-label{font-size:10px}}
</style>
