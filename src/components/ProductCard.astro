---
import {pagePath} from '../config/site';
import {makerFor,labels,price} from '../lib/catalog';
import type {Product} from '../lib/schema';
import Pattern from './Pattern.astro';
import RetailerLink from './RetailerLink.astro';
interface Props { product:Product; index?:number }
const {product:p,index=0}=Astro.props;
---
<article class="product-card" data-product-card data-type={p.productType.join(' ')} data-prefecture={p.prefectureIds.join(' ')} data-material={p.materialIds.join(' ')} data-craft={p.craftIds.join(' ')}>
 <a class="card-art-link" href={pagePath(`objects/${p.slug}/`)} aria-label={`Read about ${p.title}`}><Pattern variant={index}/><span class="card-number">{String(index+1).padStart(2,'0')}</span></a>
 <div class="card-meta">{labels('productTypes',p.productType)} <span>•</span> {p.prefectureIds.length?labels('prefectures',p.prefectureIds)+' workshop':'Origin unconfirmed'}</div>
 <h3><a href={pagePath(`objects/${p.slug}/`)}>{p.title}</a></h3>
 <p class="maker-name">{makerFor(p).name}</p>
 <p class="card-summary">{p.editorialSummary}</p>
 <div class="card-price"><span>{price(p)}</span><small>{p.availability==='out_of_stock'?'Sold out when checked':`Checked ${p.priceCheckedAt}`}</small></div>
 <p class="price-note" style="margin:7px 0 0">{p.taxNote}</p>
 <div class="card-actions"><a class="text-link" href={pagePath(`objects/${p.slug}/`)}>Explore the details <span aria-hidden="true">→</span></a><RetailerLink productId={p.id} compact/></div>
</article>