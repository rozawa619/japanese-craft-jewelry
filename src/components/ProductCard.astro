---
import {pagePath} from '../config/site';
import {catalogFor,makerFor,labels,price} from '../lib/catalog';
import {t,type Locale} from '../lib/i18n';
import type {Product} from '../lib/schema';
import Pattern from './Pattern.astro';
import RetailerLink from './RetailerLink.astro';
import EditorialImage from './EditorialImage.astro';
import {productImageFor} from '../lib/editorial-images';
interface Props { product:Product; index?:number; locale?:Locale }
const {product:p,index=0,locale='en'}=Astro.props;
const detail=pagePath(`objects/${p.slug}/`,locale);
const image=productImageFor(p.id);
const maker=makerFor(p,locale);
const merchant=catalogFor(locale).merchants.find(item=>p.merchantIds.includes(item.id));
const attribution=maker.id.includes('unidentified')&&merchant?t(locale,'Available at '+merchant.name,'取り扱い：'+merchant.name):maker.name;
---
<article class="product-card" data-product-card data-type={p.productType.join(' ')} data-prefecture={p.prefectureIds.join(' ')} data-material={p.materialIds.join(' ')} data-craft={p.craftIds.join(' ')}>
 <a class="card-art-link" href={detail} aria-label={t(locale,`View ${p.title}`,`${p.title}の詳細を見る`)}>{image?<EditorialImage image={image} locale={locale} compact/>:<Pattern variant={index} locale={locale}/>}<span class="card-number">{String(index+1).padStart(2,'0')}</span></a>
 <div class="card-meta">{labels('productTypes',p.productType,locale)} <span>•</span> {labels('crafts',p.craftIds,locale)}</div>
 <h3><a href={detail}>{p.title}</a></h3>
 <p class="maker-name">{attribution}</p>
 <p class="card-summary">{p.editorialSummary}</p>
 <div class="card-price"><span>{price(p,locale)}</span><small>{p.availability==='out_of_stock'?t(locale,'Sold out when checked','確認時点で欠品') : t(locale,`Checked ${p.priceCheckedAt}`,`${p.priceCheckedAt}確認`)}</small></div>
 <p class="price-note card-tax-note">{p.taxNote}</p>
 <div class="card-actions"><a class="text-link" href={detail}>{t(locale,'Explore the details','詳しく見る')} <span aria-hidden="true">→</span></a><RetailerLink productId={p.id} compact locale={locale}/></div>
</article>
<style>
 .card-art-link :global(.editorial-image){margin:0}
 .card-art-link :global(.editorial-image img){aspect-ratio:1;object-position:56% 40%}
 .card-art-link :global(.editorial-image figcaption){font-size:10px;padding:10px 12px;line-height:1.6}
 @media(max-width:720px){.card-art-link :global(.editorial-image img){aspect-ratio:.9}.card-art-link :global(.editorial-image figcaption){font-size:8px;padding:9px 8px}}
</style>
