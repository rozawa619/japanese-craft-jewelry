---
import {sources} from '../lib/catalog';
import {t,type Locale} from '../lib/i18n';
interface Props {sourceIds:string[];locale?:Locale;id?:string;className?:string}
const {sourceIds,locale='en',id,className}=Astro.props;
const items=sources.filter(s=>sourceIds.includes(s.id));
---
<details id={id} class:list={['source-disclosure',className]} data-source-disclosure>
 <summary>{t(locale,'Sources & checked dates','出典と確認日')}</summary>
 <div class="source-disclosure-body">
  <slot/>
  {items.length>0&&<section aria-label={t(locale,'Primary sources','一次情報の出典')}><h2>{t(locale,'Official sources','一次情報の一覧')}</h2><p class="muted">{t(locale,'Desk research from official pages. No physical wear test or maker interview was conducted.','公式ページをもとに調査しています。実物の着用試験や工房への取材は行っていません。')}</p><ol class="source-list">{items.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} <span aria-hidden="true">↗</span><span class="sr-only">{t(locale,', opens in a new tab','、新しいタブで開きます')}</span></a><small><time datetime={s.checkedAt}>{s.checkedAt}</time>{t(locale,' checked','確認')} · {s.access==='body_read'||s.access==='official page body inspected using web tool'?t(locale,'Official page inspected','公式ページ本文を確認'):t(locale,'Access limited — see research record','閲覧に制約あり・詳細は調査記録に記載')}</small></li>)}</ol></section>}
 </div>
</details>
<script>
 const revealSourceTarget=()=>{
  let id:string;try{id=decodeURIComponent(location.hash.slice(1))}catch{return}
  const target=id?document.getElementById(id):null;
  if(!target)return;
  let matched=false;
  for(let node:HTMLElement|null=target;node;node=node.parentElement){
   if(node instanceof HTMLDetailsElement&&node.hasAttribute('data-source-disclosure')){node.open=true;matched=true}
  }
  if(matched)requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));
 };
 addEventListener('hashchange',revealSourceTarget);revealSourceTarget();
</script>
<style>
 .source-disclosure{border-block:1px solid var(--line);margin-top:24px;min-width:0;scroll-margin-top:24px}
 .source-disclosure>summary{font:14px/1.6 var(--sans);padding:17px 4px;min-height:56px;cursor:pointer;overflow-wrap:break-word}
 .source-disclosure>summary:hover{color:var(--accent)}
 .source-disclosure-body{padding:6px 4px 25px;min-width:0}
 .source-disclosure-body h2{font:22px/1.5 var(--serif);letter-spacing:0;margin:0 0 14px}
 .source-disclosure-body p{font-size:12px;line-height:1.9}
 .source-disclosure-body :global(.information-checks){border-bottom:1px solid var(--line);padding-bottom:17px;margin-bottom:24px}
 .source-disclosure-body :global(.information-checks dl){display:grid;gap:12px;margin:0 0 16px;font-size:12px;line-height:1.8}
 .source-disclosure-body :global(.information-checks dl>div){display:grid;grid-template-columns:minmax(120px,1fr) minmax(0,2fr);gap:12px}
 .source-disclosure-body :global(.information-checks dt){color:var(--muted)}
 .source-disclosure-body :global(.information-checks dd){margin:0;overflow-wrap:anywhere}
 .source-disclosure-body :global(a){overflow-wrap:anywhere}
 @media(max-width:720px){.source-disclosure>summary{font-size:14px}.source-disclosure-body :global(.information-checks dl>div){grid-template-columns:1fr;gap:2px}}
</style>
