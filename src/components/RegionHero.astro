---
import geometry from '../data/japan-map-geometry.json';
import {catalogFor,productsFor} from '../lib/catalog';
import {contentFor,contentSlug} from '../lib/content';
import {productImageFor} from '../lib/editorial-images';
import {storyFor} from '../lib/product-stories';
import {selection} from '../config/selection';
import {regionalRepresentatives} from '../config/region-selection';
import {pagePath,path} from '../config/site';
import {serializeJsonLd} from '../lib/structured-data';
import {t,type Locale} from '../lib/i18n';
import EditorialImage from './EditorialImage.astro';
import MarketPrice from './MarketPrice.astro';
interface Props{locale:Locale}
const{locale}=Astro.props;
const products=productsFor(locale),catalog=catalogFor(locale);
const notes=(await contentFor('places',locale)).filter(note=>note.body?.trim());
const preferred=products.find(product=>product.id===selection.heroProductId)||products[0];
if(!preferred)throw new Error('The regional hero requires a published product');
const firstRegion=preferred.prefectureIds.find(id=>notes.some(note=>note.data.prefectureId===id));
const regions=geometry.prefectures.flatMap(prefecture=>{
 const region=catalog.prefectures.find(item=>item.id===prefecture.id);
 const note=notes.find(item=>item.data.prefectureId===prefecture.id);
 const local=products.filter(product=>product.prefectureIds.includes(prefecture.id));
 if(!region||!note||!local.length)return[];
 const representative=(region.id===firstRegion?local.find(product=>product.id===preferred.id):undefined)||local.find(product=>product.id===regionalRepresentatives[region.id])||local.find(product=>productImageFor(product.id));
 const image=representative&&productImageFor(representative.id);
 if(!representative||!image)throw new Error('A regional hero destination needs its sourced styling image: '+region.id);
 return[{id:region.id,name:region.name,count:local.length,countLabel:t(locale,`${local.length} ${local.length===1?'piece':'pieces'}`,`${local.length}点のジュエリー`),url:pagePath(`places/${contentSlug(note)}/`,locale),productId:representative.id,productTitle:representative.title,productUrl:pagePath(`objects/${representative.slug}/`,locale),headline:storyFor(representative.id,locale).headline,image:{...image,src:path(image.path)},controlLabel:t(locale,`Show the styling image for ${region.name}`,`${region.name}の着用イメージに切り替える`)}];
});
const available=new Map(regions.map(region=>[region.id,region]));
const first=available.get(firstRegion||'')||regions[0];
if(!first)throw new Error('The regional hero requires a published destination');
const okinawa=geometry.prefectures.find(prefecture=>prefecture.id==='okinawa');
if(!okinawa)throw new Error('The regional hero requires the original Okinawa geometry');
const okinawaRegion=available.get(okinawa.id);
// The original CC0 paths stay unchanged. Separate viewports remove the long
// southwest gap: mainland bounds are 97.60,0.28–436.98,383.12; Okinawa's are
// 0.32,421.31–125.92,515.63. Both viewports retain a margin around every island.
const mainlandViewBox='89 -8 356 400',okinawaViewBox='-6 415 138 108';
const okinawaInsetLabel=t(locale,'Okinawa · enlarged','沖縄（拡大）');
const uid='regional-hero';
---
<section class="region-hero selection-hero wrap" data-region-hero data-hero-selected={first.id} data-hero-default={first.id} aria-labelledby={uid+'-title'}>
 <header class="hero-heading"><p class="eyebrow">{t(locale,'JAPANESE CRAFT, YOUR NEXT DISCOVERY','日本の工芸と、次の旅先。')}</p><h1 id={uid+'-title'}>{locale==='ja'?<><span class="title-phrase">日本の工芸<span class="title-word">ジュエリー</span>を、</span><span class="title-phrase">旅先から。</span></>:'Japanese craft jewelry, by destination.'}</h1><p class="hero-intro-text">{t(locale,'Choose a place on the map. Find a little piece of Japan to make your own.','地図から行き先を選んで、あなたらしいひとつを。')}</p>
  <a class="button hero-trip-link" href="#travel-finder">{t(locale,'Search by destination','旅先から探す')}<span aria-hidden="true">↓</span></a>
 </header>
 <div class="hero-regional-layout">
  <div class="hero-model-panel" data-hero-model-panel>
   <div class="hero-styling" data-hero-image-frame><EditorialImage image={first.image} locale={locale} priority/></div>
   <div class="hero-product-cards">{regions.map(region=><a class:list={['hero-product-link',{'selection-hero-product':region.id===first.id}]} href={region.productUrl} data-hero-card={region.id} data-hero-product={region.productId} hidden={region.id!==first.id}>
    <span><span class="hero-product-headline">{region.headline}</span><span class="hero-product-title">{region.productTitle}</span><small>{t(locale,'View this piece','この商品を見る')} <span aria-hidden="true">→</span></small></span><span class="hero-product-price"><MarketPrice productId={region.productId} locale={locale}/></span>
   </a>)}</div>
  </div>
  <div class="hero-map-panel" data-hero-map-panel>
   <div class="hero-selected-region" aria-live="polite" aria-atomic="true"><p class="eyebrow">{t(locale,'CHOOSE A PLACE IN JAPAN','日本の、どこへ行きますか。')}</p><h2 data-hero-region-name>{first.name}</h2><p data-hero-region-count>{first.countLabel}</p></div>
   <div class="hero-map-stage" data-hero-map-stage>
    <svg viewBox={mainlandViewBox} class="hero-map-svg" role="group" aria-label={t(locale,'Map of Japan. Okinawa is enlarged in a separate inset. Highlighted prefectures link to their jewelry.','日本地図。沖縄は別枠で拡大しています。色の付いた県から産地の商品へ進めます。')} data-hero-map>
     {geometry.prefectures.filter(prefecture=>prefecture.id!==okinawa.id).map(prefecture=>{const region=available.get(prefecture.id);return region?<a href={region.url} data-hero-choice={region.id} data-hero-code={prefecture.code} aria-label={t(locale,`Explore jewelry from ${region.name}`,`${region.name}の商品を見る`)} data-hero-active={region.id===first.id?'true':undefined}><title>{region.name}</title><path d={prefecture.d} data-hero-shape={prefecture.id}/></a>:<path d={prefecture.d} class="hero-map-unlisted" data-hero-unlisted={prefecture.id} data-hero-shape={prefecture.id}><title>{prefecture.name[locale]} — {t(locale,'not featured yet','未掲載')}</title></path>})}
    </svg>
    {okinawaRegion?<a class="hero-okinawa-inset" href={okinawaRegion.url} data-hero-choice={okinawa.id} data-hero-code={okinawa.code} data-hero-okinawa-inset data-hero-inset-label={okinawaInsetLabel} aria-label={okinawaInsetLabel+' — '+t(locale,`Explore jewelry from ${okinawaRegion.name}`,`${okinawaRegion.name}の商品を見る`)} data-hero-active={okinawa.id===first.id?'true':undefined}>
     <span class="hero-okinawa-label">{okinawaInsetLabel}<span aria-hidden="true">↗</span></span>
     <svg viewBox={okinawaViewBox} aria-hidden="true" focusable="false" data-hero-okinawa-svg><path d={okinawa.d} data-hero-shape={okinawa.id}/></svg>
    </a>:<div class="hero-okinawa-inset hero-okinawa-unlisted" data-hero-okinawa-inset><span class="hero-okinawa-label">{okinawaInsetLabel}</span><svg viewBox={okinawaViewBox} aria-label={t(locale,'Okinawa — not featured yet','沖縄県 — 未掲載')} role="img" data-hero-okinawa-svg><path d={okinawa.d} class="hero-map-unlisted" data-hero-unlisted={okinawa.id} data-hero-shape={okinawa.id}/></svg></div>}
   </div>
   <div class="hero-map-legend"><span><i></i>{t(locale,'Jewelry to explore','掲載商品がある産地')}</span><span data-hero-instruction>{t(locale,'Explore the highlighted destinations.','色の付いた産地から探せます。')}</span></div>
   <div class="hero-region-field" data-hero-select-field hidden><label for={uid+'-select'}>{t(locale,'Choose a destination','行き先を選ぶ')}</label><select id={uid+'-select'} data-hero-select>{regions.map(region=><option value={region.id} selected={region.id===first.id}>{region.name} · {region.countLabel}</option>)}</select></div>
   <a class="hero-region-destination" href={first.url} data-hero-destination><span data-hero-destination-label>{t(locale,`Explore ${first.name}`,`${first.name}の商品を見る`)}</span><span aria-hidden="true">→</span></a>
  </div>
 </div>
 <noscript><details class="hero-fallback"><summary>{t(locale,'All destinations','掲載産地を一覧から選ぶ')}</summary><ul>{regions.map(region=><li><a href={region.url} data-hero-fallback-region={region.id}>{region.name}<span>{region.countLabel}</span></a></li>)}</ul><p>{t(locale,'The map links open each region. Changing the styling image requires JavaScript.','地図から各産地の商品へ進めます。着用イメージの切替にはJavaScriptが必要です。')}</p></details></noscript>
 <script type="application/json" data-hero-data set:html={serializeJsonLd({regions,defaultRegion:first.id,exploreBefore:t(locale,'Explore ',''),exploreAfter:t(locale,'','の商品を見る'),mapLabel:t(locale,'Choose a prefecture to change the styling image. Okinawa is enlarged in a separate inset.','県を選ぶと着用イメージが切り替わります。沖縄は別枠で拡大しています。'),instruction:t(locale,'Select a place to change the image.','県を選ぶと、イメージが変わります。')})}/>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-region-hero]').forEach(root=>{
  type Destination={id:string;name:string;countLabel:string;url:string;productId:string;productTitle:string;productUrl:string;controlLabel:string;image:{src:string;assetId:string;width:number;height:number;preserveRatio?:boolean;alt:{ja:string;en:string}}};
  // Mainland SVG links and the whole HTML Okinawa inset share one selection flow.
  type HeroChoice=HTMLAnchorElement|SVGAElement;
  let data:{regions:Destination[];defaultRegion:string;exploreBefore:string;exploreAfter:string;mapLabel:string;instruction:string};
  try{data=JSON.parse(root.querySelector('[data-hero-data]')?.textContent||'')}catch{return;}
  const regions=new Map(data.regions.map(region=>[region.id,region]));
  const image=root.querySelector<HTMLImageElement>('[data-hero-image-frame] img');
  const figure=root.querySelector<HTMLElement>('[data-hero-image-frame] [data-editorial-asset]');
  const select=root.querySelector<HTMLSelectElement>('[data-hero-select]');
  const destination=root.querySelector<HTMLAnchorElement>('[data-hero-destination]');
  const name=root.querySelector<HTMLElement>('[data-hero-region-name]');
  const count=root.querySelector<HTMLElement>('[data-hero-region-count]');
  const destinationLabel=root.querySelector<HTMLElement>('[data-hero-destination-label]');
  if(!image||!figure||!select||!destination||!name||!count||!destinationLabel||!regions.has(data.defaultRegion))return;
  const locale=document.documentElement.lang==='ja'?'ja':'en';
  image.dataset.heroImage='';
  function choose(id:string,updateUrl=false){
   const region=regions.get(id);if(!region||!image||!figure||!select||!destination||!name||!count||!destinationLabel)return;
   root.dataset.heroSelected=id;select.value=id;name.textContent=region.name;count.textContent=region.countLabel;
   figure.dataset.editorialAsset=region.image.assetId;
   if(region.image.preserveRatio)figure.dataset.preserveRatio='true';else delete figure.dataset.preserveRatio;
   image.width=region.image.width;image.height=region.image.height;image.alt=region.image.alt[locale];image.src=region.image.src;
   for(const card of root.querySelectorAll<HTMLAnchorElement>('[data-hero-card]')){const active=card.dataset.heroCard===id;card.hidden=!active;card.classList.toggle('selection-hero-product',active);}
   destination.href=region.url;destinationLabel.textContent=data.exploreBefore+region.name+data.exploreAfter;
   for(const control of root.querySelectorAll<HeroChoice>('[data-hero-choice]')){const active=control.dataset.heroChoice===id;control.setAttribute('aria-pressed',String(active));if(active)control.dataset.heroActive='true';else delete control.dataset.heroActive;}
   if(updateUrl){const url=new URL(location.href);url.searchParams.set('region',id);history.replaceState(history.state,'',url);}
  }
  function restore(){const url=new URL(location.href),requested=url.searchParams.get('region');if(requested&&regions.has(requested))choose(requested);else{choose(data.defaultRegion);if(requested!==null){url.searchParams.delete('region');history.replaceState(history.state,'',url);}}}
  for(const control of root.querySelectorAll<HeroChoice>('[data-hero-choice]')){
   const id=control.dataset.heroChoice,region=id&&regions.get(id);if(!id||!region)continue;
   const insetLabel=control.dataset.heroInsetLabel;
   control.setAttribute('role','button');control.setAttribute('aria-label',insetLabel?insetLabel+' — '+region.controlLabel:region.controlLabel);
   control.addEventListener('click',event=>{if(!(event instanceof MouseEvent)||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||event.button!==0)return;event.preventDefault();choose(id,true);});
   control.addEventListener('keydown',event=>{if(event instanceof KeyboardEvent&&event.key===' '){event.preventDefault();choose(id,true);}});
  }
  root.querySelector<HTMLElement>('[data-hero-select-field]')?.removeAttribute('hidden');
  root.querySelector('[data-hero-map]')?.setAttribute('aria-label',data.mapLabel);
  const instruction=root.querySelector('[data-hero-instruction]');if(instruction)instruction.textContent=data.instruction;
  select.addEventListener('change',()=>choose(select.value,true));
  addEventListener('popstate',restore);restore();root.dataset.heroEnhanced='true';
 });
</script>
<style>
 .region-hero.selection-hero{display:block;padding-block:26px 32px}
 .hero-heading{margin-bottom:22px}.hero-heading .eyebrow{margin:0 0 9px;font-size:10px;color:var(--accent)}
 .region-hero.selection-hero h1{font:400 clamp(31px,3.4vw,48px)/1.24 var(--serif);letter-spacing:-1px;margin:0 0 10px;text-wrap:balance}
 .title-phrase{display:inline-block;max-width:100%}
 .title-word{white-space:nowrap}
 .hero-intro-text{font-size:14px;line-height:1.8;color:var(--muted);margin:0}
 .hero-trip-link{margin-top:10px;min-height:44px;gap:18px;padding:8px 14px}
 .hero-regional-layout{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:36px;align-items:start}
 .hero-model-panel,.hero-map-panel{min-width:0}.hero-styling{background:#eeeee5;border:1px solid var(--line)}
 /* Let the original photo determine the frame height: no letterbox or crop. */
 .hero-styling :global(.editorial-image){margin:0}.hero-styling :global(img){display:block;width:100%;height:auto;max-height:none;object-fit:contain!important;object-position:center!important;aspect-ratio:auto!important}
 .hero-styling :global(figcaption){font-size:.75rem;line-height:1.5;text-align:center;margin:0;padding:5px;color:var(--muted);border-top:1px solid var(--line)}
 .hero-product-link{display:flex;align-items:center;justify-content:space-between;gap:18px;font-size:13px;padding:13px 0;border-bottom:1px solid var(--line);text-decoration:none;min-width:0}
 .hero-product-link>span:first-child{min-width:0;flex:1}.hero-product-link .hero-product-headline{display:block;font:17px/1.5 var(--serif);margin-bottom:5px}.hero-product-title{display:block;font-size:11px;line-height:1.6;color:var(--muted);overflow-wrap:anywhere}
 .hero-product-link small{display:block;font-size:11px;margin-top:5px;color:var(--forest)}.hero-product-price{min-width:110px;max-width:145px;white-space:normal!important}.hero-product-cards>[hidden]{display:none}
 .hero-selected-region .eyebrow{font-size:9px;margin:0 0 7px;color:var(--muted)}.hero-selected-region h2{font:400 clamp(25px,3vw,38px)/1.2 var(--serif);letter-spacing:0;margin:0 0 4px}.hero-selected-region>p:last-child{font-size:11px;margin:0;color:var(--muted)}
 .hero-map-stage{position:relative;margin:6px 0}.hero-map-svg{display:block;width:100%;height:400px;max-width:100%;margin:0 auto}.hero-map-stage path{stroke:var(--paper);stroke-width:.8;stroke-linejoin:round;vector-effect:non-scaling-stroke}.hero-map-svg a{fill:#637d72;cursor:pointer;outline:none}.hero-map-svg a:hover{fill:#7d9188}.hero-map-svg a[data-hero-active=true]{fill:var(--accent)}.hero-map-svg a:focus-visible path{stroke:var(--forest);stroke-width:2.2}.hero-map-unlisted{fill:#deded5}
 .hero-okinawa-inset{position:absolute;inset:18px auto auto 0;display:block;width:clamp(66px,32%,200px);min-width:44px;min-height:44px;padding:7px;text-decoration:none;border:1px dashed var(--muted);background:var(--paper);color:var(--forest)}.hero-okinawa-label{display:flex;justify-content:space-between;align-items:center;gap:3px;font-size:11px;line-height:1.4}.hero-okinawa-label>span{font-size:12px}.hero-okinawa-inset svg{display:block;width:100%;height:auto;aspect-ratio:138/108;margin-top:4px;fill:#637d72}.hero-okinawa-inset svg path{stroke-width:.35}.hero-okinawa-inset:hover{border-style:solid;background:#eeeee5}.hero-okinawa-inset:hover svg{fill:#7d9188}.hero-okinawa-inset[data-hero-active=true]{border-color:var(--accent);color:var(--accent);border-style:solid}.hero-okinawa-inset[data-hero-active=true] svg{fill:var(--accent)}.hero-okinawa-inset:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.hero-okinawa-unlisted{color:var(--muted)}
 .hero-map-legend{display:flex;flex-wrap:wrap;justify-content:space-between;gap:5px 12px;font-size:10px;color:var(--muted);line-height:1.7;margin:0 0 11px}.hero-map-legend>span:first-child{display:inline-flex;align-items:center;gap:6px}.hero-map-legend i{display:inline-block;width:9px;height:9px;background:#637d72}
 .hero-region-field{display:flex;align-items:center;gap:12px;margin:0 0 10px}.hero-region-field label{font-size:11px;flex:none}.hero-region-field select{font:16px/1.4 var(--sans);color:var(--forest);background:var(--paper);border:1px solid var(--muted);border-radius:0;min-width:0;min-height:44px;width:100%;padding:9px 30px 9px 10px}
 .hero-region-destination{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--forest);color:var(--paper);min-height:48px;text-decoration:none;font-size:13px;line-height:1.6;padding:12px 16px}.hero-region-destination:hover{background:#354a41}
 .hero-region-destination:focus-visible,.hero-product-link:focus-visible,.hero-region-field select:focus-visible,.hero-fallback a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
 .hero-fallback{margin-top:16px;border-block:1px solid var(--line)}.hero-fallback summary{min-height:46px;align-content:center;font-size:13px;padding-block:8px;cursor:pointer}.hero-fallback ul{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 20px}.hero-fallback a{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;text-decoration:none;font-size:12px;padding-block:8px}.hero-fallback a span{font-size:10px;color:var(--muted)}.hero-fallback p{font-size:12px;color:var(--muted);margin-top:10px}
 @media(max-width:1000px){.hero-regional-layout{gap:26px}.hero-map-svg{height:340px}.hero-product-link{display:block}.hero-product-price{display:block;max-width:none;margin-top:9px}.hero-product-headline{font-size:15px}.hero-region-field{display:block}.hero-region-field label{display:block;margin-bottom:5px}.hero-okinawa-label{font-size:10px}}
 @media(max-width:720px){.region-hero.selection-hero{padding-block:20px 26px}.region-hero.selection-hero h1{font-size:29px;line-height:1.3;letter-spacing:0}.hero-heading{margin-bottom:16px}.hero-heading .eyebrow{font-size:9px}.hero-intro-text{font-size:12px}.hero-regional-layout{gap:18px}.hero-map-svg{height:280px}.hero-selected-region h2{font-size:27px}.hero-product-link .hero-product-headline{font-size:15px}.hero-region-destination{font-size:12px;padding-inline:12px}.hero-map-legend>span:last-child{display:none}.hero-map-legend{font-size:9px}.hero-fallback ul{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-okinawa-inset{inset-block-start:10px;padding:5px}.hero-okinawa-label{font-size:9px}.hero-okinawa-label>span{font-size:10px}}
 @media(max-width:480px){.region-hero.selection-hero h1{font-size:25px}.hero-regional-layout{gap:14px 12px;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}.hero-model-panel{display:contents}.hero-styling{grid-column:1/-1;grid-row:1}.hero-product-cards{grid-column:1;grid-row:2;min-width:0}.hero-map-panel{grid-column:2;grid-row:2;min-width:0}.hero-selected-region{display:flex;align-items:baseline;flex-wrap:wrap;gap:2px 7px}.hero-selected-region .eyebrow{flex-basis:100%;font-size:8px;letter-spacing:.7px;line-height:1.6;margin-bottom:3px}.hero-selected-region h2{font-size:23px;margin:0}.hero-selected-region>p:last-child{font-size:9px}.hero-map-svg{height:220px}.hero-map-legend{font-size:8px;letter-spacing:0}.hero-okinawa-inset{inset-block-start:5px;min-width:80px}.hero-okinawa-label{display:block;font-size:9px;line-height:1.4}.hero-okinawa-label>span{display:none}.hero-product-link{padding-block:9px}.hero-product-link .hero-product-headline{font-size:14px}.hero-product-title{font-size:10px}.hero-product-link small{font-size:10px}.hero-product-price{min-width:0;margin-top:7px}.hero-product-price :global(.market-price-label),.hero-product-price :global(.market-price-unit){font-size:9px}.hero-product-price :global(.market-price-amount){font-size:12px}.hero-region-field label{font-size:10px;line-height:1.6}.hero-region-field select{font-size:16px;padding-left:7px;padding-right:23px}.hero-region-destination{font-size:11px;min-height:48px;padding:10px}.hero-fallback ul{grid-template-columns:1fr}}
 @media(max-width:360px){.hero-regional-layout{row-gap:10px}}
 @media(max-width:480px){.region-hero.selection-hero h1:lang(ja){font-size:clamp(1.375rem,6.25vw,1.5625rem)}}
</style>
