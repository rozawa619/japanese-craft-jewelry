{
  "name": "japanese-craft-jewelry",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.3"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "check": "node scripts/astro.mjs check && node --experimental-strip-types scripts/validate.ts && node --experimental-strip-types scripts/validate-visits.ts && node --experimental-strip-types scripts/validate-selection.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "node --experimental-strip-types scripts/validate.ts && node --experimental-strip-types scripts/validate-visits.ts && node --experimental-strip-types scripts/validate-selection.ts && node scripts/astro.mjs build && node scripts/prune-retired-images.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "verify": "pnpm check && pnpm test && pnpm build && node scripts/check-built.mjs && pnpm check:images && pnpm check:privacy && pnpm check:detail-images",
    "readiness": "node --experimental-strip-types scripts/readiness.ts",
    "check:links": "node scripts/check-external.mjs",
    "check:browser": "node scripts/check-bilingual.mjs",
    "check:ads": "node scripts/check-ad-build.mjs",
    "package": "node scripts/package-source.mjs",
    "check:prices": "node scripts/check-market-prices.mjs",
    "check:quality": "node scripts/check-quality-expansion.mjs",
    "check:copy": "node scripts/check-editorial-copy.mjs",
    "check:images": "node --experimental-strip-types scripts/check-editorial-images.mjs --dist",
    "check:seo": "node scripts/check-international-seo.mjs",
    "check:privacy": "node --experimental-strip-types scripts/check-advertising-privacy.mjs",
    "check:depth": "node scripts/check-privacy-depth.mjs",
    "check:detail-images": "node --experimental-strip-types scripts/check-product-detail-images.mjs",
    "check:sources": "node scripts/check-source-lists.mjs",
    "check:mobile": "node scripts/check-mobile-refinement.mjs",
    "check:types": "node scripts/check-type-choice-images.mjs",
    "check:headings": "node scripts/check-regional-headings.mjs",
    "package:delivery": "pwsh -NoProfile -File scripts/package-delivery.ps1",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "astro": "7.4.12",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0"
  }
}
